<?xml version="1.0" encoding="UTF-8"?>
<t:test expected="pass"
        xmlns:t="http://xproc.org/ns/testsuite/3.0">
   <t:info>
      <t:title>Text document 002 (AB)</t:title>
      <t:revision-history>
         <t:revision>
            <t:date>2026-06-24</t:date>
            <t:author>
               <t:name>Achim Berndzen</t:name>
            </t:author>
            <t:description xmlns="http://www.w3.org/1999/xhtml">
               <p>Added new tests for XProc 3.2 text documents.</p>
            </t:description>
         </t:revision>
      </t:revision-history>
   </t:info>
   <t:description xmlns="http://www.w3.org/1999/xhtml">
      <p>Tests XProc 3.2. clarification: A document node with a single text node is "text/plain"</p>
   </t:description>
   <t:pipeline>
      <p:declare-step version="3.2"
                      xmlns:p="http://www.w3.org/ns/xproc">
         <p:output port="result"/>
         <p:xquery>
            <p:with-input><p:empty /></p:with-input>
            <p:with-input port="query">
               <p:inline content-type="text/plain" expand-text="false">document{text{"This is a text"}}</p:inline>
            </p:with-input>
         </p:xquery>
         
         <p:identity>
            <p:with-input><content-type>{p:document-property(., 'content-type')}</content-type></p:with-input>
         </p:identity>
      </p:declare-step>
   </t:pipeline>
   <t:schematron>
      <s:schema queryBinding="xslt2"
                xmlns:s="http://purl.oclc.org/dsdl/schematron">
         <s:pattern>
            <s:rule context="/">
               <s:assert test="content-type">The document root is not content-type.</s:assert>
               <s:assert test="content-type/text()='text/plain'">The content-type is not text/plain.</s:assert>
            </s:rule>
         </s:pattern>
      </s:schema>
   </t:schematron>
</t:test>