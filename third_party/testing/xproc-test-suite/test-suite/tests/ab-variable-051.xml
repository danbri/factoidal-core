<?xml version="1.0" encoding="UTF-8"?>
<t:test expected="pass"
        xmlns:t="http://xproc.org/ns/testsuite/3.0">
   <t:info>
      <t:title>Variable declaration 051</t:title>
      <t:revision-history>
         <t:revision>
            <t:date>2026-07-19</t:date>
            <t:author>
               <t:name>Achim Berndzen</t:name>
            </t:author>
            <t:description xmlns="http://www.w3.org/1999/xhtml">
               <p>New tests.</p>
            </t:description>
         </t:revision>
      </t:revision-history>
   </t:info>
   <t:description xmlns="http://www.w3.org/1999/xhtml">
      <p>Tests parameters on p:variable/p:document</p>
   </t:description>
   <t:pipeline>
      <p:declare-step name="pipeline"
         version="3.0"
         xmlns:p="http://www.w3.org/ns/xproc"
         xmlns:err="http://www.w3.org/ns/xproc-error">
         <p:output port="result"/>
         
         <p:try>
            <p:variable name="var" select=".">
               <p:document href="../documents/ab-doc.xml" parameters="map{'dtd-validate' : true()}" />
            </p:variable>
            <p:identity>
               <p:with-input><failed /></p:with-input>
            </p:identity>
            
            <p:catch code="err:XD0023">
               <p:identity>
                  <p:with-input><passed /></p:with-input>
               </p:identity>
            </p:catch>
         </p:try>
      </p:declare-step>
   </t:pipeline>
   <t:schematron>
      <s:schema queryBinding="xslt2"
                xmlns:s="http://purl.oclc.org/dsdl/schematron"
                xmlns="http://www.w3.org/1999/xhtml">
         <s:pattern>
            <s:rule context="/">
               <s:assert test="passed">The root element is not 'passed'.</s:assert>
            </s:rule>
         </s:pattern>
      </s:schema>
   </t:schematron>
</t:test>