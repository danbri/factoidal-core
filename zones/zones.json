{
  "schema_version": 1,
  "roots": [
    "formal/lean4/L4Factoidal",
    "labs/demos/foafnaut",
    "docs/web/hub",
    "npm",
    "tools"
  ],
  "glob_semantics": "Case-sensitive fnmatch on repository-relative POSIX paths; * crosses /. Rules are unordered unions with explicit exclusions; exactly one rule must match.",
  "zones": [
    {
      "id": "dom",
      "name": "DOM",
      "definition": "Document trees, mutation, selectors, events and DOM adapters."
    },
    {
      "id": "js",
      "name": "JS (BubblePopJS)",
      "definition": "JavaScript interpretation, compilation and language support."
    },
    {
      "id": "wasm",
      "name": "WASM (BubblePopWASM)",
      "definition": "WebAssembly decoding, validation, execution and guest tooling."
    },
    {
      "id": "html",
      "name": "HTML language",
      "definition": "HTML tokenisation, tree building, serialisation and element language rules."
    },
    {
      "id": "style",
      "name": "Style",
      "definition": "CSS parsing, cascade, computed values and styling for HTML and SVG."
    },
    {
      "id": "xml",
      "name": "XML stack",
      "definition": "XML, XPath, XSLT, XQuery, schemas, shared XPath functions and regex, and XML pipelines."
    },
    {
      "id": "rdf",
      "name": "RDF stack",
      "definition": "RDF syntaxes, queries, logic, validation, graph storage and planning."
    },
    {
      "id": "json",
      "name": "JSON stack",
      "definition": "JSON, JSON-LD, JSON Schema, CSVW and related structured-data readers."
    },
    {
      "id": "network",
      "name": "Network and protocols",
      "definition": "URLs, Fetch policy, HTTP, WebSocket, XMPP and transport protocols."
    },
    {
      "id": "security",
      "name": "Cryptography, auth and identity",
      "definition": "Cryptography, credentials, identity, access control, Solid and LWS."
    },
    {
      "id": "graphics",
      "name": "Graphics, GPU and ML/AI",
      "definition": "Raster and vector graphics, GPU kernels, media codecs and WebNN."
    },
    {
      "id": "browser",
      "name": "Browser integration and infrastructure",
      "definition": "Hosts, shell, event loop, shared primitives, package surfaces and general tooling."
    },
    {
      "id": "rendering",
      "name": "Rendering engine",
      "definition": "Layout, paint, scene construction, fonts, shaping and Unicode text."
    }
  ],
  "rules": [
