{
  "name": "@factoidal/core",
  "version": "0.10.0",
  "description": "Factoidal: a linked information system with graph data and the Web at its heart - RDF parsing (Turtle, TriG, N-Triples, N-Quads, RDF/XML, JSON-LD), SPARQL 1.1 query and update, RDFC-1.0 canonicalization, RDFS/OWL reasoning, SHACL and ShEx validation and a persisted store, for Node and the browser. One engine: the Lean 4 library L4Factoidal compiled to WebAssembly.",
  "keywords": [
    "sparql",
    "rdf",
    "turtle",
    "ntriples",
    "nquads",
    "trig",
    "rdf-xml",
    "formal-verification",
    "semantic-web",
    "lean4",
    "webassembly",
    "shacl",
    "json-ld"
  ],
  "homepage": "https://github.com/danbri/factoidal",
  "bugs": {
    "url": "https://github.com/danbri/factoidal/issues"
  },
  "license": "Apache-2.0",
  "author": "Dan Brickley <danbri@danbri.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbri/factoidal.git",
    "directory": "npm/factoidal"
  },
  "main": "./index.js",
  "module": "./index.mjs",
  "browser": "./browser.js",
  "types": "./index.d.ts",
  "bin": {
    "factoidal": "./bin/factoidal.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./api": {
      "types": "./api.d.ts",
      "import": "./api.mjs",
      "require": "./api.js",
      "default": "./api.js"
    },
    "./rdfjs": {
      "import": "./rdfjs.mjs",
      "require": "./rdfjs.js",
      "default": "./rdfjs.js"
    },
    "./fn": {
      "types": "./fn.d.ts",
      "default": "./fn.js"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "default": "./browser.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "browser": "./core-browser.js",
      "import": "./core.mjs",
      "require": "./core.js",
      "default": "./core.js"
    },
    "./core-browser": {
      "types": "./core-browser.d.ts",
      "default": "./core-browser.js"
    },
    "./package.json": "./package.json",
    "./l4-assets/*": "./l4-assets/*",
    "./store-host": "./store-host/index.mjs",
    "./store-host/paths": "./store-host/paths.mjs",
    "./xmpp": "./xmpp/index.mjs",
    "./sample-store": {
      "types": "./sample-store.d.ts",
      "default": "./sample-store.mjs"
    },
    "./store": {
      "default": "./bin/store.mjs"
    },
    "./store-worker": {
      "default": "./bin/store-worker-host.mjs"
    },
    "./serve": {
      "default": "./bin/serve.mjs"
    },
    "./pack": {
      "default": "./bin/pack.mjs"
    },
    "./engine": {
      "default": "./bin/engine.mjs"
    },
    "./lws": {
      "default": "./lws/server.mjs"
    },
    "./solid/server": {
      "default": "./solid/server/index.mjs"
    },
    "./solid/client": {
      "default": "./solid/client/index.mjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "api.js",
    "api.mjs",
    "api.d.ts",
    "rdfjs.js",
    "rdfjs.mjs",
    "fn.js",
    "fn.d.ts",
    "browser.js",
    "browser.d.ts",
    "core.js",
    "core.mjs",
    "core.d.ts",
    "core-browser.js",
    "core-browser.d.ts",
    "l4-assets/",
    "lib/",
    "bin/",
    "lws/",
    "solid/",
    "store-host/",
    "xmpp/",
    "sample-store.mjs",
    "sample-store.d.ts",
    "sample-store/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "scripts": {
    "build": "bash ../../formal/lean4/Wasm/build-wasm.sh",
    "test": "node --test 'test/*.test.js' 'test/*.test.mjs'",
    "test:speed": "node ../../tests/perf/npm_speed_gate.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
