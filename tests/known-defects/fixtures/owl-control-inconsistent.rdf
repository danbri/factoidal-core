<?xml version="1.0"?>
<!--
  Sensitivity control for the OWL cases in tests/known-defects/run.sh.
  Individual a is an instance of DataMaxCardinality(1 dp), unqualified,
  and has the dp-values 1 and 2 (distinct xsd:integer values).
  The ontology is INCONSISTENT (OWL 2 Direct Semantics). Both engines
  must report that. If the F* probe does not report it, the probe cannot
  see an inconsistency and the OWL cases are not measuring anything.
-->
<rdf:RDF xml:base="http://example.org/" xmlns="http://example.org/"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="http://example.org/o-control"/>
  <owl:DatatypeProperty rdf:about="dp"/>
  <rdf:Description rdf:about="a">
    <rdf:type>
      <owl:Restriction>
        <owl:onProperty rdf:resource="dp"/>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </rdf:type>
    <dp rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</dp>
    <dp rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</dp>
  </rdf:Description>
</rdf:RDF>
