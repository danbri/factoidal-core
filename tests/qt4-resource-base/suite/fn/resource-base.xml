<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="resource-base"><dependency type="spec" value="XP40+ XQ40+"/><dependency type="feature" value="fn-transform-XSLT"/>
<test-case name="inline-existing-base"><test><![CDATA[name(transform(map {'stylesheet-text':"<xsl:stylesheet xmlns:xsl='http://www.w3.org/1999/XSL/Transform' version='3.0'><xsl:include href='shared.xsl'/></xsl:stylesheet>", 'stylesheet-base-uri':'a/base.xsl', 'initial-template':QName('', 'main')})?output/*)]]></test><result><assert-string-value>a</assert-string-value></result></test-case>
<test-case name="inline-nonexistent-base"><test><![CDATA[name(transform(map {'stylesheet-text':"<xsl:stylesheet xmlns:xsl='http://www.w3.org/1999/XSL/Transform' version='3.0'><xsl:include href='shared.xsl'/></xsl:stylesheet>", 'stylesheet-base-uri':'b/missing.xsl', 'initial-template':QName('', 'main')})?output/*)]]></test><result><assert-string-value>b</assert-string-value></result></test-case>
<test-case name="same-basename-distinct-directories"><test><![CDATA[string-join((name(transform(map {'stylesheet-text':"<xsl:stylesheet xmlns:xsl='http://www.w3.org/1999/XSL/Transform' version='3.0'><xsl:include href='shared.xsl'/></xsl:stylesheet>", 'stylesheet-base-uri':'a/missing.xsl', 'initial-template':QName('', 'main')})?output/*), name(transform(map {'stylesheet-text':"<xsl:stylesheet xmlns:xsl='http://www.w3.org/1999/XSL/Transform' version='3.0'><xsl:include href='shared.xsl'/></xsl:stylesheet>", 'stylesheet-base-uri':'b/missing.xsl', 'initial-template':QName('', 'main')})?output/*)), '|')]]></test><result><assert-string-value>a|b</assert-string-value></result></test-case>
<test-case name="outside-direct"><test><![CDATA[unparsed-text('../../outside/sentinel.txt')]]></test><result><error code="FOUT1170"/></result></test-case>
<test-case name="outside-inferred"><test><![CDATA[name(transform(map {'stylesheet-text':"<xsl:stylesheet xmlns:xsl='http://www.w3.org/1999/XSL/Transform' version='3.0'><xsl:include href='shared.xsl'/></xsl:stylesheet>", 'stylesheet-base-uri':'../../outside/missing.xsl', 'initial-template':QName('', 'main')})?output/*)]]></test><result><error code="XTSE0165"/></result></test-case>
<test-case name="external-query-base"><test file="queries/sub/main.xq"/><result><assert-string-value>a</assert-string-value></result></test-case>

<test-case name="absent-query-target-param-collision"><environment><param name="hint" select="'shared.txt'"/></environment><test file="queries/sub/missing.xq"/><result><error code="FOUT1170"/></result></test-case>
<test-case name="correct-query-target-param-collision"><environment><param name="hint" select="'shared.txt'"/></environment><test file="queries/present/main.xq"/><result><assert-string-value>query</assert-string-value></result></test-case>
<test-case name="absent-query-target-earlier-collision"><test file="queries/earlier/prepare.xq"/><test file="queries/sub/missing.xq"/><result><error code="FOUT1170"/></result></test-case>
<test-case name="explicit-virtual-base-direct"><environment><static-base-uri uri="https://example.org/virtual/query.xq"/></environment><test>unparsed-text('shared.txt')</test><result><assert-string-value>parameter</assert-string-value></result></test-case>
<test-case name="explicit-virtual-base-inferred"><environment><static-base-uri uri="https://example.org/virtual/query.xq"/></environment><test><![CDATA[name(transform(map {'stylesheet-text':"<xsl:stylesheet xmlns:xsl='http://www.w3.org/1999/XSL/Transform' version='3.0'><xsl:include href='shared.xsl'/></xsl:stylesheet>", 'stylesheet-base-uri':'a/missing.xsl', 'initial-template':QName('', 'main')})?output/*)]]></test><result><assert-string-value>a</assert-string-value></result></test-case>
<test-case name="undefined-base-does-not-preload"><environment><static-base-uri uri="#UNDEFINED"/></environment><test>unparsed-text('shared.txt')</test><result><error code="FOUT1170"/></result></test-case>
</test-set>
