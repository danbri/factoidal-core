PREFIX ex: <http://ex.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# A language tag in VALUES matches the stored term whatever its case (RDF 1.2
# Concepts 3.4). Since issue 1001 (2026-10-24) the parser writes the tag in
# lower case, so the query runs on ids; from 2026-10-23 until then it took the
# reference fallback (IdQuery.valueIdM, issue 776).
SELECT ?s ?n WHERE { ?s ex:name ?n } VALUES ?n { "Alice"@EN "carol" "nobody"@EN }
