PREFIX ex: <http://ex.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# A FILTER beside the OPTIONAL over the optional variable: applied after the
# left join (Filter(f, LeftJoin(...))), ?f unbound where no flag.
SELECT ?s ?f WHERE { ?s ex:age ?a OPTIONAL { ?s ex:flag ?f } FILTER(!BOUND(?f)) }
