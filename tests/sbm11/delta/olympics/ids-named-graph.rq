# A named graph only the delta log has.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX foaf: <http://xmlns.com/foaf/0.1/> PREFIX dbo: <http://dbpedia.org/ontology/> PREFIX dbp: <http://dbpedia.org/property/> PREFIX wso: <http://wallscope.co.uk/ontology/olympics/>
SELECT ?g ?a ?t WHERE { GRAPH ?g { ?a dbo:team ?t } }
