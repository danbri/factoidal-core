# FILTER equality on a language-tagged literal.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbp: <http://dbpedia.org/property/>
PREFIX wso: <http://wallscope.co.uk/ontology/olympics/>
PREFIX wsr: <http://wallscope.co.uk/resource/olympics/>
SELECT ?a WHERE { ?a rdfs:label ?l FILTER(?l = "Hermann Schreiber"@en) } ORDER BY ?a
