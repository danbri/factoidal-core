PREFIX ex:   <http://example.org/>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
PREFIX uom: <http://www.opengis.net/def/uom/OGC/1.0/>
SELECT ?a ?d ?m WHERE {
  ex:London ex:hasGeom ?h .
  ?x ex:name ?a ; ex:hasGeom ?g .
  BIND(geof:distance(?g, ?h, uom:degree) AS ?d)
  BIND(geof:distance(?g, ?h, uom:metre) AS ?m)
} ORDER BY ?a
