  },
  {
   "expect": "message",
   "contains": "xforms-rebuild"
  },
  {
   "expect": "message",
   "contains": "xforms-recalculate"
  },
  {
   "expect": "message",
   "contains": "xforms-revalidate"
  },
  {
   "expect": "message",
   "contains": "xforms-refresh"
  }
 ]
