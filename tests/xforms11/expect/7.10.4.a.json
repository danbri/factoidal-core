  {
   "expect": "control",
   "label": "Bad Fruit picked",
   "value": "apple"
  },
  {
   "do": "activate",
   "label": "orange"
  },
  {
   "expect": "control",
   "label": "Bad Fruit picked",
   "value": "orange"
  },
  {
   "do": "activate",
   "label": "mandarine"
  },
  {
   "expect": "control",
   "label": "Bad Fruit picked",
   "value": "mandarine"
  },
  {
   "do": "activate",
   "label": "tomato"
  },
  {
   "expect": "control",
   "label": "Bad Fruit picked",
   "value": "tomato"
  }
 ]
