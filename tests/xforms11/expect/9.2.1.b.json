   "do": "setvalue",
   "label": "Please tell me your name",
   "value": "Ada"
  },
  {
   "do": "activate",
   "label": "Send Name"
  },
  {
   "expect": "control",
   "label": "Hello",
   "value": "Ada",
   "relevant": true
  },
  {
   "expect": "control",
   "label": "Edit",
   "kind": "trigger",
   "relevant": true
  },
  {
   "expect": "control",
   "label": "Send Name",
   "kind": "trigger",
   "relevant": false
  },
  {
   "expect": "control",
   "label": "Please tell me your name",
   "relevant": false
  },
  {
   "do": "activate",
   "label": "Edit"
  },
  {
   "expect": "control",
   "label": "Send Name",
   "kind": "trigger",
   "relevant": true
  },
  {
   "expect": "control",
   "label": "Please tell me your name",
   "value": "Ada",
   "relevant": true
  },
  {
   "expect": "control",
   "label": "Edit",
   "kind": "trigger",
   "relevant": false
  }
 ]
