# Claude Code session state (rule #18). Tracked template is
# .claude-worklog.template.md; the live worklog is session-specific
# and must not be committed.
.claude-worklog.md
.claude-runs/

# tools/module-liveness.py's standalone depcheck bootstrap cache
# (#448 Part 2) — rebuilt on demand from committed sources
# (formal/fstar/ocaml-output/Dep_Reachability.ml + bin/depcheck/
# depcheck.ml), never itself a committed artifact.
tools/.depcheck-cache/

# Claude Code runtime state — local settings and harness scratch.
# settings.json (the shared project hooks) IS tracked; settings.local.json
# and the scheduled_tasks lockfile are per-machine and are not.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local editor / OS cruft
.DS_Store

# F* verification cache (regenerated by `make verify`)
*.fst.checked
*.fsti.checked

# Playwright MCP auto-created profile dir (per-machine, contains
# browser state from QA sessions)
.playwright-mcp/

# Scratch work — fixtures generated for ad-hoc benchmarks, perf
# traces, audit harnesses. Per-session, never committed.
tmp/
_tmp.junk/

# Stale git worktree metadata from earlier subagent isolation attempts.
.claude/worktrees/

# Per-invocation logs from build-ocaml.sh's heartbeat-wrapped stages
# (fstar.exe / ocamlopt / ocamlc / js_of_ocaml / wasm_of_ocaml). These
# are useful for one-off diagnosis but should not land in git.
formal/fstar/ocaml-output/_fstar_*.log
formal/fstar/ocaml-output/_ocamlopt_*.log
formal/fstar/ocaml-output/_ocamlc_*.log
formal/fstar/ocaml-output/_jsoo_*.log
formal/fstar/ocaml-output/_waoc_*.log
formal/fstar/ocaml-output/_layer_*.log

# Incremental-extract manifest (build-ocaml.sh's per-module .fst content
# hashes, used to skip fstar.exe invocation for unchanged modules). Local
# build-cache state, not a committed artifact — digest-keyed like
# *.fst.checked, so a missing/stale copy just costs a full re-extract.
formal/fstar/ocaml-output/.extract-state/

# Local pycottas DuckDB artefacts and Python caches from corpus pipeline
# experiments — not source-of-truth, regenerated by tools/.
formal/fstar/pycottas.duckdb
tools/__pycache__/
**/__pycache__/
third_party/data/ukparliament/*.trig
third_party/data/ukparliament/*.nq

# Application logs (per-invocation log files emitted by --log-file or
# FACTOIDAL_LOG_FILE). Gitignored — these are runtime artefacts, not source.
data/logs/

# Eleventy npm-cache byproduct: `third_party/eleventy/install.sh docs`
# populates an offline npm cache under here and the docs build writes
# _logs/ into it. The vendored cache tree is committed; its per-run log
# byproducts are not — they recur on every docs build and otherwise trip
# the untracked-files stop hook.
third_party/eleventy/npm-cache/_logs/

# Vendored external mocha test suites' installed dependency trees
# (task #88, canivc.com integration) — installed at run time via
# `npm install`, never committed; see each suite's PROVENANCE.md.
third_party/testing/vc-di-eddsa/node_modules/
third_party/testing/vc/node_modules/
third_party/testing/vc-di-eddsa/localConfig.cjs
third_party/testing/vc-di-eddsa/reports/*.json
third_party/testing/vc-di-eddsa/suite.log
third_party/testing/vc/localConfig.cjs

# Score-history snapshots: not a reliable timeseries (record-keeping conventions
# changed repeatedly). Re-evaluate old builds against a common tool instead.
docs/test-results/history/

# Makefile-generated F* dependency graph (fstar.exe --dep full output).
# Regenerated whenever any .fst/.fsti changes; never a source of truth.
formal/fstar/.depend

# jsonld context cache: transient flock file, never content
third_party/jsonld-context-cache/.index.lock

# Transient proof-experiment probes (agent investigations; promoted
# into formal/fstar/repro/ if informative, deleted otherwise)
/EqTransExp*.fst
/formal/fstar/EqTransExp*.fst

# Apache Jena binary distribution cache for tests/unit/run-jena-diff.sh
# (issue #317 differential testing harness). Fetched on demand by
# tools/install-jena-for-diff-testing.sh; not committed (24MB+ third-
# party binary, versioned independently of this repo).
/.jena-cache/

# Jena differential harness (issue #317) downloads its reference engine
# here. It is a 22MB third-party distribution fetched by
# tools/install-jena-for-diff-testing.sh, not repo content.
.jena-cache/
tests/xmpp/node_modules/
tests/xmpp/package-lock.json

# esbuild devDependency for the bundler CSP smoke test (issue #682) --
# installed by `npm install` inside npm/factoidal, not committed.
# npm/factoidal/package-lock.json IS committed.
npm/factoidal/node_modules/

# Build products, installed by tools/fetch-builds.sh from danbri/factoidal-builds
# releases (2026-10-09 split; CLAUDE.md iron rule 9). Never committed here.
# The rule mirrors tools/repo-split/core-tip-exclude.py.
/bin/linux-x86_64/
/bin/darwin-arm64/
/bin/ci-*/
/bin/*/*.cmi
/bin/*/*.cmx
/bin/*/*.cmo
/bin/*/*.cmt
/bin/*/*.o
/bin/*/*.byte
/.factoidal-builds/
/docs/test-results/*
!/docs/test-results/closure-bench-baseline.json
!/docs/test-results/perf-quadstore-baseline.json
!/docs/test-results/perf-quadstore-baseline.fragment.html
!/docs/test-results/ukparliament-bench.json
!/docs/test-results/ukparliament-bench.csv
!/docs/test-results/ukparliament-bench-modern.json
!/docs/test-results/ukparliament-bench-modern.csv
/docs/npm/
/docs/fstar-extracted/w3c-runner.js
/docs/fstar-extracted/w3c-runner.wasm.js
/docs/fstar-extracted/factoidal.js
/docs/fstar-extracted/factoidal.wasm.js
/docs/fstar-extracted/factoidal.debug.js
/docs/fstar-extracted/factoidal.debug.map
