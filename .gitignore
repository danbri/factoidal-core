/docs/fstar-extracted/factoidal-npm-entry.wasm.js
/docs/fstar-extracted/factoidal-npm-entry-lite.js
/docs/fstar-extracted/factoidal-npm-entry-lite.wasm.js
/docs/fstar-extracted/*.wasm.assets/
/docs/fstar-extracted/*_results.log
/docs/web/hub/assets/l4/l4factoidal.wasm
/docs/web/hub/assets/l4/l4factoidal.mjs
/npm/factoidal/factoidal.js
/npm/factoidal/factoidal.wasm.js
/npm/factoidal/factoidal.wasm.assets/
/npm/factoidal/factoidal-npm-entry.js
/npm/factoidal/factoidal-npm-entry.wasm.js
/npm/factoidal/factoidal-npm-entry.wasm.assets/
/npm/factoidal/factoidal-npm-entry-lite.js
/npm/factoidal/factoidal-npm-entry-lite.wasm.js
/npm/factoidal/factoidal-npm-entry-lite.wasm.assets/
/npm/factoidal/l4-assets/l4factoidal.js
/npm/factoidal/l4-assets/l4factoidal.mjs
/npm/factoidal/l4-assets/l4factoidal.wasm
/npm/factoidal-lean/l4factoidal.js
/npm/factoidal-lean/l4factoidal.mjs
/npm/factoidal-lean/l4factoidal.wasm
/formal/fstar/ocaml-output/*.cmi
/formal/fstar/ocaml-output/*.cmx
/formal/fstar/ocaml-output/*.cmo
/formal/fstar/ocaml-output/*.o
/formal/fstar/ocaml-output/*.byte
