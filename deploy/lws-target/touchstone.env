# How Touchstone's targetservers/run-all.sh tests this target: a bash file it
# sources, with $ORIGIN and $TARGET set. Paths are relative to the target's URL,
# $ORIGIN/targets/$TARGET. Copy this directory to targetservers/factoidal/.
TS_NAME=Factoidal
TS_LANGUAGE="Lean 4 (wasm in Node.js)"
TS_BASE=touchstone/
TS_STORAGE=
TS_ISSUER=
TS_AUTH=harness
TS_KEY_CMD=(sh -c 'factoidal authz-keys /data/as --private | node -e "process.stdout.write(JSON.stringify(JSON.parse(require(\"fs\").readFileSync(0, \"utf8\")).keys[0]))"')
TS_KEY_FORMAT=jwk
TS_CAPABILITIES="Authentication, HarnessIssuedTokens"
