# Copy to fly.toml and set your own app name.
app = "replace-with-your-app-name"
primary_region = "lhr"
[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0
  [[http_service.checks]]
    method = "GET"
    path = "/healthz"
    interval = "30s"
    timeout = "5s"
[[vm]]
  memory = "1024mb"
  cpu_kind = "shared"
  cpus = 1
