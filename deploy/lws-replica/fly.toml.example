# Deploy as a NEW app first. Do not replace skosdex's existing configuration.
app = "replace-with-your-replica-app"
primary_region = "lhr"

[build]
  dockerfile = "Dockerfile"

[env]
  PUBLIC_ORIGIN = "https://replace-with-your-replica-app.fly.dev"
  SITE_ADDRESS = "http://:8080"
  WRITER_SUBJECT = "urn:example:dan-laptop"

[[mounts]]
  source = "lws_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

[[http_service.checks]]
  grace_period = "60s"
  interval = "15s"
  method = "GET"
  timeout = "5s"
  path = "/lws/"

[[vm]]
  size = "shared-cpu-1x"
  memory = "1024mb"
