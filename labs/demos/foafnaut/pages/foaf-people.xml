<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="foaf-people.xsl"?>
<!-- Synthetic FOAF data for a demo page: the people are invented. RDF/XML in the
     "striped" layout (one rdf:Description per person, rdf:resource for links);
     foaf-people.xsl reads this layout, not every possible RDF/XML layout. -->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/">
 <foaf:Person rdf:about="https://example.org/friends/alice">
  <foaf:name>Alice</foaf:name><foaf:nick>alice</foaf:nick>
  <foaf:knows rdf:resource="https://example.org/friends/bob"/>
  <foaf:knows rdf:resource="https://example.org/friends/ani"/>
  <foaf:knows rdf:resource="https://example.org/friends/eleni"/>
  <foaf:topic_interest rdf:resource="https://example.org/topics/xslt"/>
 </foaf:Person>
 <foaf:Person rdf:about="https://example.org/friends/bob">
