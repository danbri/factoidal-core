<!-- SPARQL 1.1 Query Results XML. The results are real: Factoidal 0.33.0 (npm @factoidal/core,
     engine l4factoidal-wasm 0.2.0) ran the query below over foaf-people.xml. The commands were
     factoidal pack (layout sbm11, syntax rdfxml), factoidal activate, and factoidal query with
     the JSON format. A short script wrote the JSON results in this XML form, unchanged.

     PREFIX foaf: <http://xmlns.com/foaf/0.1/>
     PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
     SELECT ?name (COUNT(DISTINCT ?friend) AS ?knows) (COUNT(DISTINCT ?fan) AS ?knownBy)
            (GROUP_CONCAT(DISTINCT ?topic; separator=", ") AS ?interests)
     WHERE {
       ?p foaf:name ?name .
       OPTIONAL { ?p foaf:knows ?friend }
       OPTIONAL { ?fan foaf:knows ?p }
       OPTIONAL { ?p foaf:topic_interest/rdfs:label ?topic }
     }
     GROUP BY ?name
     ORDER BY DESC(?knownBy) DESC(?knows) ?name
-->
