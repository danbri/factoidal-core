 <!-- ty:text sets a string as SVG paths, one for each character, from the glyph table
      ty:font below. The engine does not draw SVG <text> yet (issue 1270). -->
 <xsl:key name="ty:glyph" match="ty:g" use="@c"/>
 <xsl:function name="ty:width" as="xs:double">
  <xsl:param name="text" as="xs:string"/><xsl:param name="size" as="xs:double"/>
  <xsl:sequence select="sum(for $c in string-to-codepoints($text) return number((key('ty:glyph', codepoints-to-string($c), $ty:font)/@a, 600)[1])) * $size div 1000"/>
 </xsl:function>
 <xsl:function name="ty:text">
  <xsl:param name="text" as="xs:string"/><xsl:param name="x" as="xs:double"/><xsl:param name="y" as="xs:double"/>
  <xsl:param name="size" as="xs:double"/><xsl:param name="fill" as="xs:string"/><xsl:param name="anchor" as="xs:string"/>
  <xsl:variable name="x0" select="if ($anchor = 'middle') then $x - ty:width($text, $size) div 2 else if ($anchor = 'end') then $x - ty:width($text, $size) else $x"/>
  <g fill="{$fill}" transform="translate({format-number($x0, '0.##')} {format-number($y, '0.##')}) scale({$size div 1000} {-$size div 1000})">
   <xsl:iterate select="string-to-codepoints($text)">
    <xsl:param name="pen" select="0"/>
    <xsl:variable name="g" select="key('ty:glyph', codepoints-to-string(.), $ty:font)"/>
    <xsl:if test="string($g/@d) != ''"><path transform="translate({$pen} 0)" d="{$g/@d}"/></xsl:if>
    <xsl:next-iteration><xsl:with-param name="pen" select="$pen + number(($g/@a, 600)[1])"/></xsl:next-iteration>
   </xsl:iterate>
  </g>
 </xsl:function>
