+
+/// Foafnaut wasm build: the one state store of this process on wasm32-unknown-unknown.
+/// `arti-client` takes its state manager from it there; the embedder reads and fills it
+/// with `snapshot` and `preload`.
+#[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+pub fn wasm_shared_state() -> &'static TestingStateMgr {
+    static SHARED: std::sync::OnceLock<TestingStateMgr> = std::sync::OnceLock::new();
+    SHARED.get_or_init(TestingStateMgr::new)
+}
