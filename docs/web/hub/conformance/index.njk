<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'">
<title>Conformance — Factoidal</title>
<meta name="description" content="{{ description }}">
<style>
/* One light and one dark token set; data-theme on <html> wins over the system setting. */
:root{color-scheme:light;
  --bg:#fff;--surface:#fcfcfb;--ink:#1f2328;--ink2:#52514e;--muted:#6a6862;--line:#e1e0d9;--base:#c3c2b7;
  --accent:#2d6a4f;--link:#1f6b4a;--s1:#2a78d6;--s2:#eb6834;--target:#52514e;--track:#e6effb;
  --r0:#e6effb;--r1:#b7d3f6;--r2:#6da7ec;--r3:#2a78d6;--r4:#184f95;--r5:#0d366b}
@media (prefers-color-scheme: dark){:root:where(:not([data-theme="light"])){color-scheme:dark;
  --bg:#121417;--surface:#1a1a19;--ink:#e6e8eb;--ink2:#c3c2b7;--muted:#a3a198;--line:#2c2c2a;--base:#383835;
  --accent:#7fd0a7;--link:#7fd0a7;--s1:#3987e5;--s2:#d95926;--target:#a3a198;--track:#17263a;
  --r0:#17263a;--r1:#104281;--r2:#1c5cab;--r3:#3987e5;--r4:#86b6ef;--r5:#cde2fb}}
:root[data-theme="dark"]{color-scheme:dark;
  --bg:#121417;--surface:#1a1a19;--ink:#e6e8eb;--ink2:#c3c2b7;--muted:#a3a198;--line:#2c2c2a;--base:#383835;
  --accent:#7fd0a7;--link:#7fd0a7;--s1:#3987e5;--s2:#d95926;--target:#a3a198;--track:#17263a;
  --r0:#17263a;--r1:#104281;--r2:#1c5cab;--r3:#3987e5;--r4:#86b6ef;--r5:#cde2fb}
*{box-sizing:border-box}
html{background:var(--bg);color:var(--ink)}
body{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;max-width:1100px;margin:1em auto;padding:0 16px;line-height:1.5;overflow-wrap:break-word;background:var(--bg)}
a{color:var(--link)}
nav{font-size:.95em;margin-bottom:1em} nav a{display:inline-block;padding:.4em .9em .4em 0}
h1{border-bottom:2px solid var(--accent);padding-bottom:.3em;margin:.2em 0 .4em;font-size:1.9rem}
h2{font-size:1.45rem;margin:1.6em 0 .3em} h3{font-size:1.1rem;margin:0 0 .3em} h4{font-size:.98rem;margin:1.1em 0 .4em}
p{margin:.3em 0 .6em;max-width:72ch}
.lede{font-size:1.05rem}
.muted{color:var(--muted);font-size:.9rem}
.asof{color:var(--ink2);font-size:.92rem}
.stale{border:1px solid var(--line);border-left:4px solid var(--s2);border-radius:6px;padding:6px 10px;background:var(--surface);font-size:.92rem}
.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:12px 0;min-width:0}
.card.hero{border-color:var(--base);padding:18px 18px}
.big{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 14px;margin:.2em 0}
.big b{font-size:2.2rem;font-weight:650;font-variant-numeric:tabular-nums;line-height:1.1}
.t262 .hero .big:not(.second) b{font-size:3.2rem;color:var(--s1)}
.big.second b{font-size:1.5rem}
.big span{color:var(--ink2);font-size:.92rem}
.suite.wpt .big b{font-size:1.9rem} .suite.wpt .big.second b{font-size:1.3rem}
.hbar{position:relative;height:14px;border-radius:7px;background:var(--track);margin:24px 0 24px}
.hbar .fill{height:100%;border-radius:7px;background:var(--s1)}
.hbar .mk{position:absolute;top:-5px;bottom:-5px;width:2px;margin-left:-1px;background:var(--ink)}
.hbar .mk span{position:absolute;left:0;font-size:.72rem;color:var(--ink2);white-space:nowrap;font-style:normal}
.hbar .mk.up span{bottom:100%;transform:translateX(-100%);padding:0 4px 1px 0}
.hbar .mk.down span{top:100%;transform:translateX(-100%);padding:1px 4px 0 0}
.cmp{display:flex;flex-direction:column;gap:4px;margin:.6em 0}
.row{display:grid;grid-template-columns:minmax(96px,170px) minmax(0,1fr) 54px;gap:10px;align-items:center;font-size:.88rem;padding:4px 6px;border-radius:6px;text-align:left;color:var(--ink);background:none;border:1px solid transparent;font-family:inherit;width:100%}
.row small{display:block;color:var(--muted);font-size:.74rem;line-height:1.2}
.row .v{text-align:right;font-variant-numeric:tabular-nums}
.row.us{background:color-mix(in srgb,var(--s1) 8%,transparent)}
.row.miss .why{grid-column:2 / 4;color:var(--muted)}
button.eng{cursor:pointer;border-color:var(--line)}
button.eng[aria-pressed="true"]{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.track{position:relative;height:9px;border-radius:5px;background:var(--track);overflow:hidden;display:block}
.track .fill{display:block;height:100%;background:var(--s1);border-radius:5px 0 0 5px}
.track .tick{position:absolute;top:0;bottom:0;width:1.5px;background:var(--ink);opacity:.5}
.legend{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:.82rem;color:var(--ink2);margin:.3em 0}
.legend .sw{display:inline-block;width:12px;height:3px;border-radius:2px;margin-right:6px;vertical-align:middle}
.sw.s1{background:var(--s1)} .sw.s2{background:var(--s2)}
svg.chart{display:block;max-width:100%;height:auto;overflow:visible}
svg .grid{stroke:var(--line);stroke-width:1}
svg .ax{fill:var(--muted);font-size:11px}
svg .target{stroke:var(--target);stroke-width:1;stroke-dasharray:4 4}
svg .tl{fill:var(--ink2);font-size:11px}
svg .ln{fill:none;stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
svg .ln.s1{stroke:var(--s1)} svg .ln.s2{stroke:var(--s2)}
svg .dot{stroke:var(--surface);stroke-width:2} svg .dot.s1{fill:var(--s1)} svg .dot.s2{fill:var(--s2)}
svg .dl{font-size:11px;font-weight:600} svg .dl.s1{fill:var(--ink)} svg .dl.s2{fill:var(--ink2)}
svg .hit{fill:transparent} svg .pt:hover .dot{r:6}
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:8px;max-width:100%}
table{border-collapse:collapse;width:100%;font-size:.85rem}
th,td{padding:6px 10px;border-bottom:1px solid var(--line);white-space:nowrap;text-align:right}
th:first-child,td:first-child{text-align:left}
th{color:var(--muted);font-weight:600;font-size:.8rem}
tr:last-child td{border-bottom:0}
td{font-variant-numeric:tabular-nums}
.sortb{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;font-weight:600}
.btn{font:inherit;font-size:.84rem;padding:5px 10px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);cursor:pointer;margin-top:6px}
.btn[aria-pressed="true"]{border-color:var(--ink)}
button:focus-visible{outline:2px solid var(--s1);outline-offset:2px}
.controls{display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;margin:.4em 0}
.crumb{font-weight:600;font-size:.88rem}
.ramp{display:flex;align-items:center;gap:6px;font-size:.78rem;color:var(--muted);margin-left:auto}
.rbar{width:110px;height:9px;border-radius:5px;background:linear-gradient(90deg,var(--r0),var(--r1),var(--r2),var(--r3),var(--r4),var(--r5))}
#map{position:relative;width:100%;height:min(125vw,600px);min-height:380px;overflow:hidden;margin-top:6px}
.cell{position:absolute;border:0;border-radius:3px;overflow:hidden;cursor:pointer;padding:3px 5px;font:11px/1.2 system-ui,sans-serif;text-align:left}
.cell b{display:block;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cell.on{box-shadow:inset 0 0 0 2px var(--ink)}
.grp{position:absolute;height:14px;font-size:11px;font-weight:600;color:var(--muted);padding:0 3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;pointer-events:none;line-height:14px}
.detail{margin-top:10px;font-size:.9rem}
.detail .head{display:flex;flex-wrap:wrap;gap:4px 12px;align-items:baseline;justify-content:space-between}
.notes p{font-size:.9rem;color:var(--ink2)}
table.sw td small{display:block;color:var(--muted);font-size:.74rem}
table.sw td.st{text-align:left;white-space:normal;min-width:16ch;color:var(--ink2)}
table.sw tr.old td{color:var(--muted)}
.flag{display:inline-block;font-size:.72rem;font-weight:600;padding:0 6px;border-radius:4px;border:1px solid var(--s2);color:var(--ink)}
footer{margin:2.5em 0 1em;border-top:1px solid var(--line);padding-top:1em;font-size:.88rem;color:var(--muted)}
@media (max-width:520px){h1{font-size:1.6rem}.t262 .hero .big:not(.second) b{font-size:2.6rem}.row{grid-template-columns:92px minmax(0,1fr) 50px}.ramp{margin-left:0}}
</style>
</head>
