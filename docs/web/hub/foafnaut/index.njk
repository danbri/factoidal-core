---
layout: false
title: foafnaut
permalink: /web/hub/foafnaut/
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self'{% if podConnections %} https: http://127.0.0.1:* http://localhost:*{% endif %}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'">
  <meta name="theme-color" content="#dee3e9" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1e2025" media="(prefers-color-scheme: dark)">
  <meta name="foafnaut-build" content="{{ buildVersion }}">
  <title>foafnaut</title>
  <style>
    /* Touches belong to the browser drawn in the canvas: the outer page neither scrolls,
       bounces, refreshes on a pull, selects text, shows the long-press callout nor flashes
       a tap highlight (2026-11-08). */
    html,body{margin:0;height:100%;background:#dee3e9;overscroll-behavior:none;overflow:hidden;position:fixed;inset:0;
      -webkit-user-select:none;user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent;-webkit-text-size-adjust:100%}
    @media (prefers-color-scheme:dark){html,body{background:#1e2025}#note{color:#e6e9ee}}
    canvas{position:fixed;inset:0;width:100vw;height:100dvh;display:block;touch-action:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
    /* Screen readers (accessibility-mirror.mjs): a transparent element over each thing the engine
       drew, in the engine's accessibility tree order. They take no pointer events and draw nothing. */
    #ax{position:fixed;inset:0;margin:0;opacity:0;pointer-events:none;overflow:hidden;z-index:1;font:12px sans-serif}
    #ax *{margin:0;padding:0;border:0;overflow:hidden;white-space:pre-wrap}
    /* The switch for it: off screen until it has the focus (Tab from the start of the page). */
    #ax-switch{position:fixed;left:-9999px;top:8px;z-index:3;font:14px system-ui,sans-serif;padding:6px 10px}
    #ax-switch:focus{left:8px}
    #keys{position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;border:0;padding:0;font-size:16px}
    #stats{position:fixed;left:0;bottom:0;margin:0;padding:2px 6px;font:11px monospace;background:#000c;color:#fff;pointer-events:none}
    /* The licence line of a Hub copy (copies.mjs): who wrote the page, its licence and the
       original address. It is about the copy, not page content; the engine draws the page. */
    #copy{position:fixed;left:0;right:0;bottom:0;margin:0;padding:4px 36px 4px 10px;font:12px/16px system-ui,sans-serif;background:#f2f4f7f2;color:#1d2733;border-top:1px solid #c9d0d8;z-index:1;-webkit-user-select:text;user-select:text}
    #copy a{color:#0b57d0}
    #copy button{position:absolute;right:4px;top:2px;border:0;background:none;font:16px/20px system-ui;color:inherit;cursor:pointer;padding:0 6px}
    @media (prefers-color-scheme:dark){ #copy{background:#1d2229f2;color:#dfe5ec;border-color:#39424c}#copy a{color:#8ab4f8}}
    #note{position:fixed;left:16px;right:16px;top:45%;font:16px monospace;text-align:center;color:#000}
    #note:has(a),#note.ask{background:#fff;border:2px solid #000;padding:12px;z-index:2}
    /* Printing (issue 1268): the WebGPU canvas does not print. The print-only container
       holds images that Lean drew of the printed pages (browser-worker.mjs); the paper is
       A4 inside 36-point margins, the size Lean paginates for. */
    #print{display:none}
    @media screen{ #print{display:none}}
    @media print{
      @page{size:A4 portrait;margin:36pt}
      html,body{position:static;height:auto;overflow:visible;background:#fff}
      body>*:not(#print){display:none!important}
      #print{display:block}
      #print img{display:block;width:523pt;height:769pt;break-after:page;break-inside:avoid}
      #print img:last-of-type{break-after:auto}
      #print img.short{height:740pt;object-fit:contain;object-position:top left}
      #print img.view{width:auto;height:auto;max-width:523pt;max-height:740pt}
      #print p{font:9pt sans-serif;margin:4pt 0 0;color:#000}
    }
  </style>
</head>
<body>
  <button id="ax-switch" type="button" aria-pressed="false">Screen reader support</button>
  <canvas id="page" aria-label="foafnaut browser, drawn by the built-in engine with WebGPU"></canvas>
  <div id="ax" role="region" aria-label="Page content" hidden></div>
  <input id="keys" aria-label="Address" autocapitalize="off" autocomplete="off" autocorrect="off" spellcheck="false">
  <p id="stats" role="status" hidden></p>
  <p id="copy" hidden></p>
  <p id="note" role="status">Starting the built-in engine...</p>
  <div id="print" aria-hidden="true"></div>
  <noscript>foafnaut needs JavaScript, WebAssembly and WebGPU.</noscript>
  <script type="module" src="{{ '/web/hub/foafnaut/browser.mjs' | url }}?v={{ buildVersion }}"></script>
</body>
</html>
