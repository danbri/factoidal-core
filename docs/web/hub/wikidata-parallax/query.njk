---
layout: hub-app.njk
appBase: /web/hub/wikidata-parallax
appNoScript: true
appCommonsImages: true
appSource: https://github.com/danbri/factoidal-core/tree/main/docs/web/hub/wikidata-parallax
appEngineLabel: All queries as set browsing
appEngineUrl: ../
pagination:
  data: queries
  size: 1
  alias: q
eleventyComputed:
  title: "{{ q.title }}"
permalink: "/web/hub/wikidata-parallax/{{ q.id }}/index.html"
---
{%- import "wikidata-parallax-macros.njk" as m -%}
{%- import "wikidata-blocks-macros.njk" as b -%}
{%- set tierNote = {
  "A": "It can be built entirely by browsing: a set, facets and pivots.",
  "B": "It can be built by browsing, with a filter on values or a computed column.",
  "C": "It can be built by browsing through statements, including their qualifiers.",
  "D": "It can be built by browsing, choosing a type together with its subclasses.",
  "N": "It needs operations that browsing does not have. Each run of browsing is drawn as a chain of pieces; the orange blocks hold chains together with those operations, and pink marks a step along any property."
} -%}
{%- macro value(v) -%}
{%- if v.id and entities[v.id] -%}<a class="val" href="https://www.wikidata.org/wiki/{{ v.id }}">{{ m.thumb(v.id, entities, thumb, 20, "mini") | safe }}{{ m.bare(v.text) }}</a>
{%- else -%}<span class="val">{{ m.bare(v.text) }}</span>{%- endif -%}
{%- endmacro -%}
<div class="px px-detail">
  <p class="crumbs"><a href="../">All queries</a> › <a href="../#tier-{{ q.tier | lower }}">{{ q.tierName }}</a></p>
  <header class="q-head">
    <h1>{{ q.title }}</h1>
    <p class="q-tier">{{ m.tierBadge(q.tier) }} {{ tierNote[q.tier] }}</p>
  </header>

  {%- if q.blocks %}
  <section class="blocks" aria-label="The query as blocks">
    <p class="blocks-key"><span class="key key-set">set</span> <span class="key key-pivot">pivot</span> <span class="key key-wild">any property</span> <span class="key key-op">operation beyond browsing</span> <span class="key key-hex">condition</span></p>
    {{ b.program(q.blocks, {entities: entities, thumb: thumb}) | safe }}
  </section>
  {%- else %}
  <ol class="flow" aria-label="Sets in this query">
  {%- for s in q.flow.sets %}
    <li class="set depth-{{ s.depth if s.depth < 4 else 4 }}">
      {%- if s.via and s.via.prop %}
      <p class="pivot"><span class="pivot-arrow" aria-hidden="true">↳</span> {% if s.via.prop.startsWith("reverse of ") %}pivot to things whose <b>{{ m.bare(s.via.prop | replace("reverse of ", "")) }}</b> is this{% else %}pivot along <b>{{ m.bare(s.via.prop) }}</b>{% endif %}{% if s.via.optional %} <span class="opt">where present</span>{% endif %}</p>
      {%- elif s.stage and s.stage.joins %}
      <p class="pivot pivot-stage"><span class="pivot-arrow" aria-hidden="true">⊕</span> a grouped stage, computed on its own{% if s.stage.joins | length %} and joined on {% for j in s.stage.joins %}<span class="var">?{{ j }}</span>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
      {%- elif loop.index > 1 %}
      <p class="pivot pivot-loose">a separate set, joined to the first by a computed value</p>
      {%- endif %}
      <div class="set-card">
        <div class="set-head">
          {%- if s.typeId %}{{ m.thumb(s.typeId, entities, thumb, 48) | safe }}{% else %}<span class="thumb thumb-none thumb-set" aria-hidden="true"></span>{% endif %}
          <div>
            <h2>{% if s.typeId %}every {{ m.bare(s.title) }}{% elif s.title.startsWith("?") %}<span class="var">{{ s.title }}</span>{% else %}{{ m.bare(s.title) }}{% endif %}</h2>
            {%- if s.typeId and entities[s.typeId].description %}<p class="desc">{{ entities[s.typeId].description }}</p>{% endif %}
          </div>
        </div>
        {%- if s.facets | length %}
        <ul class="chips" aria-label="Facets">
          {%- for f in s.facets %}
          <li class="chip{% if f.optional %} chip-opt{% endif %}"><span class="prop">{% if f.reverse %}is {{ m.bare(f.prop) }} of{% else %}{{ m.bare(f.prop) }}{% endif %}</span>
            {%- for v in f.values %}{{ value(v) | safe }}{% if not loop.last %}<span class="or">or</span>{% endif %}{% endfor %}</li>
          {%- endfor %}
        </ul>
        {%- endif %}
        {%- if s.chips | length %}
        <ul class="chips" aria-label="Exclusions and alternatives">
          {%- for c in s.chips %}
          {%- if c.kind == "or" %}<li class="chip chip-any"><span class="any-label">any of</span>{% for part in c.label.split(" | ") %}<span class="alt">{{ m.bare(part) }}</span>{% if not loop.last %}<span class="or">or</span>{% endif %}{% endfor %}</li>
          {%- else %}<li class="chip chip-{{ c.verb }}"><span class="sign" aria-hidden="true">{{ "−" if c.verb == "exclude" else "+" }}</span>{{ c.verb }} if {{ m.bare(c.label) }}</li>{% endif %}
          {%- endfor %}
        </ul>
        {%- endif %}
        {%- if s.columns | length %}
        <p class="cols"><span class="cols-label">Shows</span>
          {%- for c in s.columns %} <span class="col">{% if c.prop.startsWith("reverse of ") %}things whose {{ m.bare(c.prop | replace("reverse of ", "")) }} is this{% else %}{{ m.bare(c.prop) }}{% endif %}{% if c.optional %}<span class="opt"> if any</span>{% endif %}</span>{% if not loop.last %},{% endif %}{% endfor %}</p>
        {%- endif %}
      </div>
    </li>
  {%- endfor %}
  </ol>
  {%- endif %}

  {%- if q.flow.extensions | length or (q.flow.conditions | length and not q.blocks) or q.flow.aggregate %}
  <section class="panel">
    <h2>Also</h2>
    <ul class="steps">
      {%- for e in q.flow.extensions %}
      <li><span class="kind kind-{{ e.kind }}">{{ {"or": "OR", "path": "path", "derived": "grouping"}[e.kind] }}</span> {{ m.bare(e.label) }}</li>
      {%- endfor %}
      {%- for c in ([] if q.blocks else q.flow.conditions) %}
      <li><span class="kind kind-filter">filter</span> {{ m.bare(c) }}</li>
      {%- endfor %}
      {%- if q.flow.aggregate %}<li><span class="kind kind-derived">count</span> the result is a count or summary of the sets above</li>{% endif %}
    </ul>
  </section>
  {%- endif %}

  {%- if q.flow.beyond | length %}
  <section class="panel panel-beyond">
    <h2>Beyond set browsing</h2>
    <ul>{% for b in q.flow.beyond %}<li>{{ b }}</li>{% endfor %}{% for l in ([] if q.blocks else q.flow.loose) %}<li class="loose"><code>{{ m.bare(l) }}</code></li>{% endfor %}</ul>
  </section>
  {%- endif %}

  {%- if q.flow.entities | length %}
  <section class="entities" aria-labelledby="ent-h">
    <h2 id="ent-h">Things this query mentions</h2>
    <ul class="entity-grid">
      {%- for id in q.flow.entities %}{% set e = entities[id] %}
      <li><a class="entity" href="https://www.wikidata.org/wiki/{{ id }}">
        {{ m.thumb(id, entities, thumb, 72, "ent-img") | safe }}
        <span class="ent-text"><span class="ent-label">{{ e.label }}</span><span class="ent-desc">{{ e.description }}</span><span class="ent-id">{{ id }}</span></span>
      </a></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  <p class="q-links"><a href="../../wikidata-explanations/#{{ q.id }}">Full explanation</a> ·
  <a href="{{ q.wdqs }}">Open the original in the Wikidata Query Service</a> · <span class="qid">{{ q.id }}</span></p>
</div>
