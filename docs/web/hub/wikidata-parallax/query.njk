---
layout: hub-app.njk
appBase: /web/hub/wikidata-parallax
wikidataEndpoints: true
appCommonsImages: true
appSource: https://github.com/danbri/factoidal-core/tree/main/docs/web/hub/wikidata-parallax
appEngineLabel: All queries as set browsing
appEngineUrl: ../
pagination:
  data: queries
  size: 1
  alias: q
eleventyComputed:
  title: "{{ q.title }}"
permalink: "/web/hub/wikidata-parallax/{{ q.id }}/index.html"
---
{%- import "wikidata-parallax-macros.njk" as m -%}
{%- import "wikidata-blocks-macros.njk" as b -%}
{%- set tierNote = {
  "A": "All of it is browsing: start from a set, narrow it, and pivot to related sets.",
  "B": "All of it is browsing, plus a filter on values or a computed column.",
  "C": "All of it is browsing, passing through statements and their qualifiers.",
  "D": "All of it is browsing, choosing a type together with its subclasses.",
  "N": "Browsing covers only part of it. The orange blocks hold chains of browsing together with operations that browsing does not have."
} -%}
<div class="px px-detail">
  <p class="crumbs"><a href="../">All queries</a> › <a href="../#tier-{{ q.tier | lower }}">{{ q.tierName }}</a></p>
  <header class="q-head">
    <h1>{{ q.title }}</h1>
    <p class="q-tier">{{ m.tierBadge(q.tier) }} {{ tierNote[q.tier] }}</p>
  </header>

  {{ b.highlightStyle(q.grammar.vars) | safe }}
  {%- set ctx = {entities: entities, thumb: thumb, lex: q.grammar.lex} %}
  {%- set dump = q.grammar.program | dump %}
  <section class="blocks" aria-label="The query as blocks" data-steps="{{ q.grammar.steps | length }}">
    {%- for v in q.grammar.vars %}<span class="hl-anchor" id="hl-{{ v }}"></span>{% endfor %}
    <p class="blocks-key">
      <span class="key key-set">a set of items</span>
      <span class="key key-pivot">pivot to a related set</span>
      {%- if q.tier == "N" %}<span class="key key-op">beyond browsing</span>{% endif %}
      {%- if "\"any\":true" in dump %}<span class="key key-wild">any property</span>{% endif %}
      {%- if "\"op\":\"join\"" in dump or q.grammar.program.where | length %}<span class="key key-hex">condition</span>{% endif %}
      <span class="key-hint">Point at or select a set or <span class="var">?name</span> to see everywhere it is used. Orange blocks fold away: select their top bar.</span>
      <a class="hl-clear" href="#">Clear highlight</a>
    </p>
    <div class="step-tools" hidden>
      <button type="button" class="st-start">Step through the query</button>
      <button type="button" class="st-counts">Count every step on Wikidata</button>
      <button type="button" class="st-fold">Fold all blocks</button>
      <span class="st-status" role="status"></span>
    </div>
    {{ b.program(q.grammar.program, ctx) | safe }}
  </section>
  <script type="application/json" id="grammar">{{ {steps: q.grammar.steps, prefixes: q.grammar.prefixes, full: q.grammar.full, id: q.id} | dump | replace("</", "<\\/") | safe }}</script>
  <aside class="drawer" hidden aria-label="Draft query">
    <div class="dr-bar">
      <button type="button" class="dr-prev" aria-label="Previous step">‹</button>
      <span class="dr-title" aria-live="polite"></span>
      <button type="button" class="dr-next" aria-label="Next step">›</button>
      <button type="button" class="dr-toggle" aria-expanded="true">Hide query</button>
      <button type="button" class="dr-close" aria-label="Stop stepping">×</button>
    </div>
    <div class="dr-body">
      <p class="dr-legend" aria-hidden="true"><span class="dl-new">new in this step</span> <span class="dl-chg">changed</span> <span class="dl-del">gone</span> <span class="dl-same">unchanged</span></p>
      <pre class="dr-diff" tabindex="0" aria-label="Draft SPARQL for this step, with the lines this step adds marked"></pre>
      <textarea class="dr-sparql" spellcheck="false" aria-label="Draft SPARQL for this step" hidden></textarea>
      <div class="dr-actions">
        <button type="button" class="dr-count">Count</button>
        <button type="button" class="dr-run">Run (first 50 rows)</button>
        <button type="button" class="dr-edit" aria-pressed="false">Edit</button>
        <label>on <select class="dr-endpoint">
          <option value="https://query-next.wikidata.org/sparql">Wikidata QLever (query-next)</option>
          <option value="https://qlever.dev/api/wikidata">QLever at qlever.dev</option>
        </select></label>
        <a class="dr-open" href="#" target="_blank" rel="noopener">Open in QLever</a>
        <span class="dr-status" role="status"></span>
      </div>
      <div class="dr-result"></div>
    </div>
  </aside>

  {%- if q.flow.extensions | length or q.flow.aggregate %}
  <section class="panel">
    <h2>Also</h2>
    <ul class="steps">
      {%- for e in q.flow.extensions %}
      <li><span class="kind kind-{{ e.kind }}">{{ {"or": "OR", "path": "path", "derived": "grouping"}[e.kind] }}</span> {{ m.bare(e.label) }}</li>
      {%- endfor %}
      {%- if q.flow.aggregate %}<li><span class="kind kind-derived">count</span> the result is a count or summary of the sets above</li>{% endif %}
    </ul>
  </section>
  {%- endif %}

  {%- if q.flow.why | length %}
  <section class="panel panel-beyond">
    <h2>Why browsing is not enough here</h2>
    <ul>{% for why in q.flow.why %}<li title="{{ why.code }}">{{ why.text }}</li>{% endfor %}</ul>
  </section>
  {%- endif %}

  {%- if q.flow.entities | length %}
  <section class="entities" aria-labelledby="ent-h">
    <h2 id="ent-h">Things this query mentions</h2>
    <ul class="entity-grid">
      {%- for id in q.flow.entities %}{% set e = entities[id] %}
      <li><a class="entity" href="https://www.wikidata.org/wiki/{{ id }}">
        {{ m.thumb(id, entities, thumb, 72, "ent-img") | safe }}
        <span class="ent-text"><span class="ent-label">{{ e.label }}</span><span class="ent-desc">{{ e.description }}</span><span class="ent-id">{{ id }}</span></span>
      </a></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  <p class="q-links"><a href="../../wikidata-explanations/#{{ q.id }}">Full explanation</a> ·
  <a href="{{ q.wdqs }}">Open the original in the Wikidata Query Service</a> · <span class="qid">{{ q.id }}</span></p>
</div>
