<style>
/* The Conformance page's tokens: one light and one dark set; data-theme on <html> wins over the system setting. */
:root{color-scheme:light;
  --bg:#fff;--surface:#fcfcfb;--ink:#1f2328;--ink2:#52514e;--muted:#6a6862;--line:#e1e0d9;--base:#c3c2b7;
  --accent:#2d6a4f;--link:#1f6b4a;--s1:#2a78d6;--s2:#eb6834;--target:#52514e;--track:#e6effb;
  --r0:#e6effb;--r1:#b7d3f6;--r2:#6da7ec;--r3:#2a78d6;--r4:#184f95;--r5:#0d366b}
@media (prefers-color-scheme: dark){:root:where(:not([data-theme="light"])){color-scheme:dark;
  --bg:#121417;--surface:#1a1a19;--ink:#e6e8eb;--ink2:#c3c2b7;--muted:#a3a198;--line:#2c2c2a;--base:#383835;
  --accent:#7fd0a7;--link:#7fd0a7;--s1:#3987e5;--s2:#d95926;--target:#a3a198;--track:#17263a;
  --r0:#17263a;--r1:#104281;--r2:#1c5cab;--r3:#3987e5;--r4:#86b6ef;--r5:#cde2fb}}
:root[data-theme="dark"]{color-scheme:dark;
  --bg:#121417;--surface:#1a1a19;--ink:#e6e8eb;--ink2:#c3c2b7;--muted:#a3a198;--line:#2c2c2a;--base:#383835;
  --accent:#7fd0a7;--link:#7fd0a7;--s1:#3987e5;--s2:#d95926;--target:#a3a198;--track:#17263a;
  --r0:#17263a;--r1:#104281;--r2:#1c5cab;--r3:#3987e5;--r4:#86b6ef;--r5:#cde2fb}
*{box-sizing:border-box}
html{background:var(--bg);color:var(--ink)}
body{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;max-width:1100px;margin:1em auto;padding:0 16px;line-height:1.5;overflow-wrap:break-word;background:var(--bg)}
a{color:var(--link)}
nav{font-size:.95em;margin-bottom:1em} nav a{display:inline-block;padding:.4em .9em .4em 0}
h1{border-bottom:2px solid var(--accent);padding-bottom:.3em;margin:.2em 0 .4em;font-size:1.9rem}
h2{font-size:1.45rem;margin:1.6em 0 .3em} h3.vh{font-size:1.1rem;margin:1.2em 0 .4em}
h4{font-size:.98rem;margin:1em 0 .3em} h4 .ver{color:var(--muted);font-weight:500} h5{font-size:.85rem;margin:.8em 0 .2em;color:var(--ink2)}
p{margin:.3em 0 .6em;max-width:75ch}
.lede{font-size:1.05rem}
.muted{color:var(--muted);font-size:.9rem}
.asof{color:var(--ink2);font-size:.92rem}
.stale{border:1px solid var(--line);border-left:4px solid var(--s2);border-radius:6px;padding:6px 10px;background:var(--surface);font-size:.92rem}
.chip{display:inline-block;font-size:.72rem;font-weight:600;padding:0 6px;border-radius:4px;border:1px solid var(--line);color:var(--ink);white-space:nowrap;line-height:1.6}
.chip.full{border-color:var(--s1)} .chip.partial{border-color:var(--s2);border-style:dashed} .chip.invalid{border-color:var(--s2);background:color-mix(in srgb,var(--s2) 14%,transparent)}
.chip.stale{color:var(--muted)} .chip.unrec{border-style:dotted}
.counts{display:flex;flex-wrap:wrap;gap:6px}
.tabs{display:flex;flex-wrap:wrap;gap:6px;margin:.8em 0;border-bottom:1px solid var(--line)}
.tab{font:inherit;font-size:.9rem;padding:6px 12px;border:1px solid var(--line);border-bottom:0;border-radius:6px 6px 0 0;background:var(--surface);color:var(--ink);cursor:pointer;margin-bottom:-1px}
.tab[aria-selected="true"]{background:var(--bg);border-color:var(--base);font-weight:600}
button:focus-visible,summary:focus-visible{outline:2px solid var(--s1);outline-offset:2px}
details.fam{border:1px solid var(--line);border-radius:10px;background:var(--surface);margin:8px 0}
details.fam[open]{border-color:var(--base)}
summary{cursor:pointer;list-style:none} summary::-webkit-details-marker{display:none}
.frow{display:grid;grid-template-columns:minmax(120px,190px) minmax(90px,200px) minmax(0,1fr) auto;gap:6px 14px;align-items:center;padding:10px 14px}
.fname{font-weight:650;font-size:1.02rem}
.fname::before{content:"\25B8";display:inline-block;width:1.1em;color:var(--muted);transition:transform .1s}
details[open]>summary .fname::before{transform:rotate(90deg)}
.fhead{font-size:.88rem;color:var(--ink2)} .fhead b{color:var(--ink)}
.cs{display:flex;flex-wrap:wrap;gap:4px;justify-content:flex-end;align-items:center;align-self:center}
.fbody{padding:0 14px 12px}
.track{position:relative;height:9px;border-radius:5px;background:var(--track);overflow:hidden;display:block;min-width:60px}
.track .fill{position:absolute;left:0;top:0;bottom:0;background:var(--s1)}
.track .fail{position:absolute;top:0;bottom:0;background:var(--s2)}
.strip{display:flex;gap:2px;flex-wrap:wrap} .pc{display:inline-block;width:12px;height:12px;border-radius:2px;background:var(--track);border:1px solid var(--line)}
.pc.l4{background:var(--s1);border-color:var(--s1)} .pc.l3{background:var(--r2)} .pc.l2{background:var(--r1)} .pc.l1{background:var(--r0)} .pc.l0{background:var(--bg)} .pc.na{background:repeating-linear-gradient(45deg,var(--bg) 0 2px,var(--line) 2px 4px)}
.spec{margin:.4em 0 .8em}
details.suite{border-top:1px solid var(--line)}
.srow{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(70px,1fr) minmax(92px,auto) minmax(64px,auto);gap:4px 12px;align-items:center;padding:6px 4px;font-size:.88rem}
.srow:hover{background:color-mix(in srgb,var(--s1) 6%,transparent)}
.lbl small,.v small{display:block;color:var(--muted);font-size:.74rem;line-height:1.25}
.v{text-align:right;font-variant-numeric:tabular-nums}
.sbody{padding:4px 4px 10px 12px;border-left:3px solid var(--line);margin:0 0 8px 4px;font-size:.88rem}
dl.facts{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:2px 12px;margin:.3em 0}
dl.facts dt{color:var(--muted)} dl.facts dd{margin:0}
code{font-size:.82rem;overflow-wrap:anywhere}
details.earlier>summary{font-size:.82rem;color:var(--muted);padding:4px 0}
.unrec{margin-top:.8em;padding:8px 12px;border:1px dashed var(--base);border-radius:8px}
.unrec ul{margin:.3em 0;padding-left:1.2em;font-size:.88rem} .unrec li{margin:.3em 0}
.legend{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:.82rem;color:var(--ink2);margin:.3em 0}
.legend .sw{display:inline-block;width:12px;height:3px;border-radius:2px;margin-right:6px;vertical-align:middle}
.sw.s1{background:var(--s1)} .sw.s2{background:var(--s2)}
svg.chart{display:block;max-width:100%;height:auto;overflow:visible}
svg .grid{stroke:var(--line);stroke-width:1}
svg .ax{fill:var(--muted);font-size:11px}
svg .target{stroke:var(--target);stroke-width:1;stroke-dasharray:4 4}
svg .tl{fill:var(--ink2);font-size:11px}
svg .ln{fill:none;stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
svg .ln.s1{stroke:var(--s1)} svg .ln.s2{stroke:var(--s2)}
svg .dot{stroke:var(--surface);stroke-width:2} svg .dot.s1{fill:var(--s1)} svg .dot.s2{fill:var(--s2)}
svg .dl{font-size:11px;font-weight:600} svg .dl.s1{fill:var(--ink)} svg .dl.s2{fill:var(--ink2)}
svg .hit{fill:transparent} svg .pt:hover .dot{r:6}
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:8px;max-width:100%;margin:.4em 0}
table{border-collapse:collapse;width:100%;font-size:.84rem}
th,td{padding:5px 9px;border-bottom:1px solid var(--line);white-space:nowrap;text-align:right;vertical-align:top}
th:first-child,td:first-child{text-align:left}
td.wrap{white-space:normal;text-align:left;min-width:14ch}
th{color:var(--muted);font-weight:600;font-size:.78rem}
tr:last-child td{border-bottom:0}
td{font-variant-numeric:tabular-nums} td small{display:block;color:var(--muted);font-size:.72rem}
table.specs th:nth-child(2),table.specs td:nth-child(2),table.specs th:nth-child(3){text-align:left}
tr.ph td{background:color-mix(in srgb,var(--s1) 6%,transparent);font-weight:600} td.sub{padding-left:22px;color:var(--ink2)}
ul.att{padding-left:1.2em;font-size:.9rem} ul.att li{margin:.4em 0}
.notes p{font-size:.9rem;color:var(--ink2)}
footer{margin:2.5em 0 1em;border-top:1px solid var(--line);padding-top:1em;font-size:.88rem;color:var(--muted)}
@media (max-width:720px){
  .frow{grid-template-columns:minmax(0,1fr) auto;padding:10px}
  .frow .fbar{grid-column:1/-1;order:3} .frow .fhead{grid-column:1/-1;order:4}
  .srow{grid-template-columns:minmax(0,1fr) auto}
  .srow .track{grid-column:1/-1;order:3} .srow .cs{grid-column:1/-1;order:4;justify-content:flex-start}
  .fbody{padding:0 10px 10px} h1{font-size:1.55rem}
}
</style>
</head>
