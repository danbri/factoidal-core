 /* XXX: better hash ? */
+/* Foafnaut: mix all 64 bits before the bucket mask takes the low ones. A small
+   integer as a double has its low word zero and its few significant bits at the
+   top of the high word, and a pointer has its low bits zero (alignment), so the
+   multiply alone put such keys in few buckets: in a Map of 7 000 node
+   numbers each set walked a chain of hundreds (about 65 000 Wasm instructions
+   in WasmVM, 1 800 with this mix). */
+static inline uint32_t map_hash_mix(uint64_t x)
+{
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    x *= 0xc4ceb9fe1a85ec53ULL;
+    x ^= x >> 33;
+    return (uint32_t)x;
+}
