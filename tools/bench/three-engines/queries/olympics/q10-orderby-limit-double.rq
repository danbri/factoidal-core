# ORDER BY DESC with LIMIT over xsd:double objects. QLever answers them as xsd:decimal; see the format record.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbp: <http://dbpedia.org/property/>
PREFIX wso: <http://wallscope.co.uk/ontology/olympics/>
PREFIX wsr: <http://wallscope.co.uk/resource/olympics/>
SELECT ?a ?w WHERE { ?a dbo:weight ?w } ORDER BY DESC(?w) ?a LIMIT 10
