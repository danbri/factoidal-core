# Bound subject: every triple of one athlete (SPO scan; IRI, @en literal, xsd:int and xsd:double objects).
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbp: <http://dbpedia.org/property/>
PREFIX wso: <http://wallscope.co.uk/ontology/olympics/>
PREFIX wsr: <http://wallscope.co.uk/resource/olympics/>
SELECT ?p ?o WHERE { <http://wallscope.co.uk/resource/olympics/athlete/AAananthaSambuMayavo> ?p ?o } ORDER BY ?p ?o
