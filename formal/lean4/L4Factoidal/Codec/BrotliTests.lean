/-
L4Factoidal.Codec.BrotliTests -- the build-time checks of `L4Factoidal.Codec.Brotli`.

The fixtures are top-level constants, so they live here and not in the decoder module (see the
header of `InflateTests`). This module is imported by the umbrella `L4Factoidal` only, so
`lake build` runs every `#guard` and no executable carries the fixtures.

The streams were written by libbrotli through the Python `brotli` package
(tools/brotli/brotli_vectors.py prints them); the expected sizes and SHA-256 values are of the
inputs they were made from. The transform check compares with google/brotli's own
`BrotliTransformDictionaryWord` (C, v1.1.0) over every transform of 105 dictionary words
(`tools/brotli/dump-tables <dictionary.bin> <out>` writes those bytes).
-/
import L4Factoidal.Codec.Brotli
import L4Factoidal.Crypto.SHA2

namespace L4Factoidal.Codec.Brotli

open L4Factoidal.Crypto

private def bytes (xs : List Nat) : ByteArray := ByteArray.mk (xs.map UInt8.ofNat).toArray

/-! ## Data -/

-- RFC 7932 Appendix A: 122,784 bytes, the SHA-256 of google/brotli c/common/dictionary.bin.
#guard dictionary.get.size == 122784
#guard bytesToHex (sha256 dictionary.get) == "20e42eb1b511c21806d4d227d07e5dd06877d8ce7b3a817f378f313653f35c70"
#guard dOffset[25]! == 122784
#guard transformTable.size == 121 && contextLut.size == 2048

-- Every transform applied to the dictionary words 0, 1, 2, 3 and 31 of each length 4 to 24,
-- concatenated: the SHA-256 of the same bytes from google/brotli's BrotliTransformDictionaryWord.
private def transformedWords : ByteArray := Id.run do
  let mut out := ByteArray.empty
  for l in [4:25] do
    for i in [0, 1, 2, 3, 31] do
      let off := dOffset[l]! + i * l
      let w := dictionary.get.extract off (off + l)
      for t in [0:121] do
        out := out ++ transformWord w t
  return out
#guard transformedWords.size == 199380
#guard bytesToHex (sha256 transformedWords) == "55f4f53a0e62e3a6b480c43e7f3d21179f62cbd6defd6dd54095c52e80b72e84"

#guard bitCount 0 == 0 && bitCount 1 == 1 && bitCount 255 == 8 && bitCount 703 == 10
#guard base64Decode "aGVsbG8=" == "hello".toUTF8

