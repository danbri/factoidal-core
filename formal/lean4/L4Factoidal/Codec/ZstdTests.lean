/-
L4Factoidal.Codec.ZstdTests -- the build-time checks of `L4Factoidal.Codec.Zstd`.

The fixtures are top-level constants, so they live here and not in the
decoder module: Lean evaluates a top-level constant when its module is
initialised, in every executable that links it (see the header of
`InflateTests`). This module is imported by the umbrella `L4Factoidal` only,
so `lake build` runs every `#guard` and no executable carries the fixtures.

The frames were written by libzstd 1.5.7 through the Python `zstandard`
package (tools/qlvr/zstd_vectors.py); the expected sizes and sha256 values
are libzstd's output. The larger vectors in Harness/TestData/zstd run in
`l4qlvr-zstd-check vectors`.
-/
import L4Factoidal.Codec.Zstd
import L4Factoidal.Crypto.SHA2

namespace L4Factoidal.Codec.Zstd

open L4Factoidal.Crypto

private def bytes (xs : List Nat) : ByteArray := ByteArray.mk (xs.map UInt8.ofNat).toArray

/-! ## XXH64 reference values (xxhash.com test vectors, seed 0) -/

#guard xxh64 ByteArray.empty 0 0 == 0xEF46DB3751D8E999
#guard xxh64 "a".toUTF8 0 1 == 0xD24EC4F1A98C6E5B
#guard xxh64 "abc".toUTF8 0 3 == 0x44BC2CF5AD770999
#guard xxh64 "Nobody inspects the spammish repetition".toUTF8 0 39 == 0xFBCEA83C8A378BF1
-- bytes 0..99: three 32-byte stripes, the lanes and the tail bytes (Python xxhash 3)
#guard xxh64 (ByteArray.mk ((List.range 100).map UInt8.ofNat).toArray) 0 100 == 0x6AC1E58032166597
#guard xxh64 (ByteArray.mk ((List.range 100).map UInt8.ofNat).toArray) 0 100 7 == 0x80653E7E9B887CDD

/-! ## Predefined tables fill their accuracy logs -/

#guard predefLL.sym.size == 64 && predefML.sym.size == 64 && predefOF.sym.size == 32
#guard (fseBuild llDefault 6).toOption.isSome && (fseBuild mlDefault 6).toOption.isSome &&
       (fseBuild ofDefault 5).toOption.isSome

/-! ## Frames -/

