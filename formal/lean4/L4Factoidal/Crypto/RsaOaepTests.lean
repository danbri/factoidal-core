/-! ## The constant-shape helpers -/

#guard (List.range 256).all fun i =>
  ctIsZero (UInt8.ofNat i) == (if i == 0 then 255 else 0)

#guard ctEq 7 7 == 255 && ctEq 7 8 == 0
#guard ctDiff [1, 2, 3] [1, 2, 3] == 0 && ctDiff [1, 2, 3] [1, 2, 4] != 0

/-! ## RSA Laboratories OAEP Example 1.1 (SHA-1) -/

-- Encryption with the published seed gives the published ciphertext.
#guard sameOpt (oaepEncrypt oaepSha1 refOp ex11N ex11E ex11Msg ByteArray.empty ex11Seed)
  (some ex11Ct)
-- Decryption gives the message.
#guard sameOpt (oaepDecrypt oaepSha1 refOp ex11N ex11D ex11Ct ByteArray.empty) (some ex11Msg)
-- A changed ciphertext, a non-empty label, the wrong hash: one refusal each.
#guard (oaepDecrypt oaepSha1 refOp ex11N ex11D (flipLast ex11Ct) ByteArray.empty).isNone
#guard (oaepDecrypt oaepSha1 refOp ex11N ex11D ex11Ct (hx "00")).isNone
#guard (oaepDecrypt oaepSha256 refOp ex11N ex11D ex11Ct ByteArray.empty).isNone
-- A ciphertext of the wrong length.
#guard (oaepDecrypt oaepSha1 refOp ex11N ex11D (ex11Ct.extract 1 ex11Ct.size) ByteArray.empty).isNone
-- Encoding refusals: a 19-octet seed; a message of k - 2 hLen - 1 octets
-- (one more than §7.1.1 step 1.b allows). The longest message is accepted.
#guard (oaepEncrypt oaepSha1 refOp ex11N ex11E ex11Msg ByteArray.empty
  (ex11Seed.extract 0 19)).isNone
#guard (emeEncode oaepSha1 128 [] (List.replicate 87 0x41) (ofBA ex11Seed)).isNone
#guard (emeEncode oaepSha1 128 [] (List.replicate 86 0x41) (ofBA ex11Seed)).isSome
-- The round trip of the longest message, through the reference RSA.
#guard sameOpt
  ((oaepEncrypt oaepSha1 refOp ex11N ex11E (toBA (List.replicate 86 0x41)) ByteArray.empty
      ex11Seed).bind fun c => oaepDecrypt oaepSha1 refOp ex11N ex11D c ByteArray.empty)
  (some (toBA (List.replicate 86 0x41)))

/-! ## Wycheproof, 2048 bits -/

#guard sameOpt (oaepDecrypt oaepSha1 refOp wy1N wy1D wy1Tc6Ct ByteArray.empty) (some wy1Tc6Msg)
#guard (oaepDecrypt oaepSha1 refOp wy1N wy1D wy1Tc12Ct ByteArray.empty).isNone

#guard sameOpt (oaepDecrypt oaepSha256 refOp wy256N wy256D wy256Tc6Ct ByteArray.empty)
  (some wy256Tc6Msg)
#guard sameOpt (oaepDecrypt oaepSha256 refOp wy256N wy256D wy256Tc9Ct wy256Tc9Label)
  (some wy256Tc9Msg)
-- The same ciphertext without its label is refused.
#guard (oaepDecrypt oaepSha256 refOp wy256N wy256D wy256Tc9Ct ByteArray.empty).isNone
#guard (oaepDecrypt oaepSha256 refOp wy256N wy256D wy256Tc12Ct ByteArray.empty).isNone
#guard (oaepDecrypt oaepSha256 refOp wy256N wy256D wy256Tc13Ct ByteArray.empty).isNone
#guard (oaepDecrypt oaepSha256 refOp wy256N wy256D wy256Tc14Ct ByteArray.empty).isNone

-- An OAEP-256 round trip with a 32-octet seed and a label.
#guard sameOpt
  ((oaepEncrypt oaepSha256 refOp wy256N wy256E wy256Tc6Msg wy256Tc9Label
      (toBA (List.replicate 32 0x5a))).bind fun c =>
    oaepDecrypt oaepSha256 refOp wy256N wy256D c wy256Tc9Label)
  (some wy256Tc6Msg)

