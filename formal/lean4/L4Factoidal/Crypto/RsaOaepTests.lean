def hexVal (c : Char) : Nat :=
  if c.isDigit then c.toNat - 48 else if 'a' ≤ c && c ≤ 'f' then c.toNat - 87 else c.toNat - 55

def hx (s : String) : ByteArray :=
  let rec go : List Char → List UInt8 → List UInt8
    | a :: b :: rest, acc => go rest (UInt8.ofNat (hexVal a * 16 + hexVal b) :: acc)
    | _, acc => acc.reverse
  ⟨(go s.toList []).toArray⟩

def natOfBytes (b : ByteArray) : Nat := b.foldl (fun acc x => acc * 256 + x.toNat) 0

def bytesOfNat (k : Nat) (v : Nat) : ByteArray :=
  ⟨((List.range k).reverse.map fun i => UInt8.ofNat (v / 256 ^ i % 256)).toArray⟩

/-- Square-and-multiply over `Nat`; 4097 rounds cover a 4096-bit exponent. -/
def powMod (b e m : Nat) : Nat := Id.run do
  let mut r := 1
  let mut x := b % m
  let mut y := e
  for _ in [0:4097] do
    if y == 0 then break
    if y % 2 == 1 then r := r * x % m
    x := x * x % m
    y := y / 2
  return r % m

/-- TEST REFERENCE `y^x mod n`, with the refusals of the HACL* shim that
matter here (wrong length, `y ≥ n`) but for any modulus size, so that the
1024-bit RSA Laboratories key can run. -/
def refOp (n x y : ByteArray) : Option ByteArray :=
  let nn := natOfBytes n
  let yy := natOfBytes y
  if y.size != n.size || yy ≥ nn then none
  else some (bytesOfNat n.size (powMod yy (natOfBytes x) nn))

def sameOpt (a b : Option ByteArray) : Bool :=
  a.map (·.data.toList) == b.map (·.data.toList)

def flipLast (b : ByteArray) : ByteArray :=
  if b.size = 0 then b else b.set! (b.size - 1) (b.get! (b.size - 1) ^^^ 1)

