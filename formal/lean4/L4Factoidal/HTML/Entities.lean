/-- Names that the standard recognises without the closing semicolon. -/
def entityMap : Std.HashMap String String :=
  (EntityData.entityText.splitOn ";").foldl (fun m e =>
    match e.splitOn ":" with
    | [n, cps] =>
      let hex (t : String) : Nat :=
        t.foldl (fun a c => a * 16 + (if c.isDigit then c.toNat - 48 else c.toNat - 55)) 0
      m.insert n (String.ofList ((cps.splitOn " ").filter (· != "") |>.map (fun t => Char.ofNat (hex t))))
    | _ => m) {}

/-- The characters of a named reference written with a semicolon. -/
def namedRef? (name : String) : Option String := entityMap.get? name

#guard namedRef? "AElig" == some "\u00C6"
#guard namedRef? "NotEqualTilde" == some "\u2242\u0338"

def legacyNames : List String :=
  ["amp", "AMP", "lt", "LT", "gt", "GT", "quot", "QUOT"] ++ latin1Names

/-- The C1 replacement table of the "Numeric character reference end state" (U+0080 to U+009F). -/
def c1Table : List Nat :=
  [0x20AC, 0x81, 0x201A, 0x192, 0x201E, 0x2026, 0x2020, 0x2021, 0x2C6, 0x2030, 0x160, 0x2039, 0x152, 0x8D,
   0x17D, 0x8F, 0x90, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x2DC, 0x2122, 0x161, 0x203A,
   0x153, 0x9D, 0x17E, 0x178]

def isNonCharacter (n : Nat) : Bool :=
  (0xFDD0 ≤ n && n ≤ 0xFDEF) || (n % 0x10000 == 0xFFFE) || (n % 0x10000 == 0xFFFF)

def isControlCp (n : Nat) : Bool :=
  (n ≤ 0x1F && n != 0x09 && n != 0x0A && n != 0x0C && n != 0x0D) || (0x7F ≤ n && n ≤ 0x9F)

/-- The result of a numeric reference: the character and the error codes. -/
def numericRef (n : Nat) : Char × List String :=
  if n == 0 then ('�', ["null-character-reference"])
  else if n > 0x10FFFF then ('�', ["character-reference-outside-unicode-range"])
  else if 0xD800 ≤ n && n ≤ 0xDFFF then ('�', ["surrogate-character-reference"])
  else
    let errs : List String :=
      (if isNonCharacter n then ["noncharacter-character-reference"] else [])
      ++ (if n == 0x0D || isControlCp n then ["control-character-reference"] else [])
    let m := if 0x80 ≤ n && n ≤ 0x9F then (c1Table.getD (n - 0x80) n) else n
    (Char.ofNat m, errs)

end L4Factoidal.HTML
