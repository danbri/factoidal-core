/-
L4Factoidal.WasmVM.Proofs.FoafCheckBinary: the overlap-check theorems are about the
assembled bytes (`checkBytes`, generated by labs/demos/foafnaut/wasm/build.sh and checked
by `build.sh --check`), and the assumptions that carry them to a page, stated as
hypotheses (record: docs/designissues/2026-11-09-verified-foaf-layout.md).

- `checkBytes_body`, `checkBytes_shape`: the Lean kernel runs WasmVM's decoder on the
  bytes (`decide +kernel`; no `native_decide`, no compiled code): the module has one
  function, of type `[i32 i32 i32 i32] -> [i32]`, with five i32 and eight i64 locals,
  exported as `check` next to its memory, no imports, no start function, no data; its
  body nests to `FoafCheck.checkBody`. So wabt's assembler is not trusted.
- `foaf_check_binary`: `check_certifies` for the function the bytes decode to.
- `Bridge`, `page_check_certifies`: what a page's host must do, as named hypotheses, and
  the statement about what the page receives.
-/
import L4Factoidal.WasmVM.Proofs.FoafCheck
import L4Factoidal.WasmVM.Proofs.FoafCheckBytes

namespace L4Factoidal.WasmVM.Proofs.FoafCheck
open L4Factoidal.WasmVM Proofs.SpecWP L4Factoidal.UI.Geometry

/-- The body of the module's function as WasmVM decodes it, in the subset, flat. -/
noncomputable def decodedFlat (b : ByteArray) : Option (List FKI) :=
  match Binary.decode b with
  | .ok m => m.funcs[0]?.bind fun f => FKI.ofBody f.body
  | .error _ => none

/-- The same body, nested. -/
noncomputable def decodedBody (b : ByteArray) : Option KIs := (decodedFlat b).bind FKI.nestBody

/-- The flat body of `check`, as the decoder gives it (block/loop/if open, end closes). -/
def checkFlat : List FKI := [
  .op (.i32const 1), .op (.localSet 6), .block, .loop,
  .op (.localGet 4), .op (.localGet 0), .op .i32geu, .op (.brIf 1),
  .op (.localGet 2), .op (.localGet 4), .op (.i32const 16), .op .i32mul, .op .i32add, .op (.localSet 7),
  .op (.localGet 7), .op (.load32 0), .op .i64extu, .op (.localSet 9),
  .op (.localGet 7), .op (.load32 4), .op .i64extu, .op (.localSet 10),
  .op (.localGet 7), .op (.load32 8), .op .i64extu, .op (.localSet 11),
  .op (.localGet 7), .op (.load32 12), .op .i64extu, .op (.localSet 12),
  .op (.localGet 11), .op (.localGet 9), .op .i64sub, .op (.localTee 15), .op (.i64const 0), .op (.localGet 15),
  .op (.i64const 0), .op .i64gts, .op .select,
  .op (.localGet 12), .op (.localGet 10), .op .i64sub, .op (.localTee 16), .op (.i64const 0), .op (.localGet 16),
  .op (.i64const 0), .op .i64gts, .op .select,
  .op .i64mul, .op (.localSet 13), .op (.i64const 0), .op (.localSet 14), .op (.i32const 0), .op (.localSet 5),
  .block, .loop,
  .op (.localGet 5), .op (.localGet 0), .op .i32geu, .op (.brIf 1),
  .op (.localGet 5), .op (.localGet 4), .op .i32ne, .ifThen,
  .op (.localGet 2), .op (.localGet 5), .op (.i32const 16), .op .i32mul, .op .i32add, .op (.localSet 7),
  .op (.localGet 11), .op (.localGet 7), .op (.load32 8), .op .i64extu, .op (.localTee 15), .op (.localGet 11),
  .op (.localGet 15), .op .i64lts, .op .select,
  .op (.localGet 9), .op (.localGet 7), .op (.load32 0), .op .i64extu, .op (.localTee 16), .op (.localGet 9),
  .op (.localGet 16), .op .i64gts, .op .select,
  .op .i64sub, .op (.localTee 15), .op (.i64const 0), .op (.localGet 15), .op (.i64const 0), .op .i64gts, .op .select,
  .op (.localSet 15),
  .op (.localGet 12), .op (.localGet 7), .op (.load32 12), .op .i64extu, .op (.localTee 16), .op (.localGet 12),
  .op (.localGet 16), .op .i64lts, .op .select,
  .op (.localGet 10), .op (.localGet 7), .op (.load32 4), .op .i64extu, .op (.localTee 16), .op (.localGet 10),
  .op (.localGet 16), .op .i64gts, .op .select,
  .op .i64sub, .op (.localTee 16), .op (.i64const 0), .op (.localGet 16), .op (.i64const 0), .op .i64gts, .op .select,
  .op (.localGet 15), .op .i64mul, .op (.localGet 14), .op .i64add, .op (.localSet 14),
  .end_,
  .op (.localGet 5), .op (.i32const 1), .op .i32add, .op (.localSet 5), .op (.br 0),
  .end_, .end_,
  .op (.localGet 14), .op (.i64const 10000), .op .i64mul, .op (.localGet 1), .op .i64extu, .op (.localGet 13),
  .op .i64mul, .op .i64les,
  .op (.i32const 0), .op (.localGet 13), .op (.i64const 0), .op .i64gts, .op .select, .op (.localSet 8),
  .op (.localGet 3), .op (.localGet 4), .op (.i32const 4), .op .i32mul, .op .i32add, .op (.localGet 8), .op (.store32 0),
  .op (.localGet 6), .op (.i32const 0), .op (.localGet 8), .op .select, .op (.localSet 6),
  .op (.localGet 4), .op (.i32const 1), .op .i32add, .op (.localSet 4), .op (.br 0),
  .end_, .end_,
  .op (.localGet 6), .end_]

/-- The kernel evaluates WasmVM's decoder on the bytes: the body is `checkFlat`. -/
theorem checkBytes_flat : decodedFlat checkBytes = some checkFlat := by decide +kernel

set_option maxRecDepth 20000 in
/-- `checkFlat` nests to `checkBody` (definitional unfolding of `FKI.nest`). -/
theorem checkFlat_nest : FKI.nestBody checkFlat = some checkBody := by
  unfold FKI.nestBody checkBody outerBody outerHead outerTail innerBody ifBody
  rfl

/-- The module around it: one function and one memory, both exported, nothing else. -/
def shapeOk (b : ByteArray) : Bool :=
  match Binary.decode b with
  | .ok m =>
    m.types.size == 1 &&
    m.types[0]! == { params := #[.i32, .i32, .i32, .i32], results := #[.i32] } &&
    m.funcs.size == 1 && m.funcs[0]!.type == 0 &&
    m.funcs[0]!.locals == #[.i32, .i32, .i32, .i32, .i32, .i64, .i64, .i64, .i64, .i64, .i64, .i64, .i64] &&
    m.imports.size == 0 && m.tables.size == 0 && m.globals.size == 0 && m.tags.size == 0 &&
    m.elems.size == 0 && m.datas.size == 0 && m.start.isNone &&
    m.mems.size == 1 && m.mems[0]!.limits.min == 1 &&
    m.exports.size == 2 &&
    m.exports[0]!.name == "memory" && m.exports[0]!.desc == .mem 0 &&
    m.exports[1]!.name == "check" && m.exports[1]!.desc == .func 0
  | .error _ => false

set_option maxRecDepth 20000 in
/-- The bytes decode, by WasmVM's decoder evaluated in the kernel, to `checkBody`. -/
theorem checkBytes_body : decodedBody checkBytes = some checkBody :=
  (congrArg (fun o => Option.bind o FKI.nestBody) checkBytes_flat).trans checkFlat_nest

theorem checkBytes_shape : shapeOk checkBytes = true := by decide +kernel

/-- `check_certifies` for the function whose code is what the bytes decode to. -/
theorem foaf_check_binary (S : Spec.store) (f0 : Spec.frame) (a : Nat) (yy : Spec.typeuse) (fi : Spec.funcinst)
    (x : Spec.idx) (body : KIs) (bx : List Box) (B : List Spec.byte) (cfg : UI.LayoutPolicy.Config) (boxes out : Nat)
    (hbody : decodedBody checkBytes = some body)
    (ha : a < S.FUNCS.length) (hfi : S.FUNCS[a]! = fi)
    (hty : Spec.Expand fi.TYPE (.FUNC (.mk_list [.I32, .I32, .I32, .I32]) (.mk_list [.I32])))
    (hcode : fi.CODE = .FUNC x (checkLocalTypes.map .LOCAL) (KI.toSpecs body))
    (hma : fi.MODULE.MEMS[0]! < S.MEMS.length) (hB : (S.MEMS[fi.MODULE.MEMS[0]!]!).BYTES = B)
    (hin : Inputs bx B bx.length cfg.overlapBps boxes out) :
    ∃ (S' : Spec.store) (r : Nat),
      Spec.Steps (.mk_config (.mk_state S f0)
          (vals [i32v bx.length, i32v cfg.overlapBps, i32v boxes, i32v out] ++ [.REF_FUNC_ADDR a, .CALL_REF yy]))
        (.mk_config (.mk_state S' f0) (vals [i32v r])) ∧
      (r = 1 ↔ UI.LayoutPolicy.certify cfg (bx.map some) = true) ∧
      (r = 1 → UI.LayoutPolicy.LayoutAccepted cfg (bx.map some)) ∧
      ∀ i < bx.length,
        List.take 4 (List.drop (out + 4 * i) (S'.MEMS[fi.MODULE.MEMS[0]!]!).BYTES) =
          flagBytes ((UI.LayoutPolicy.checkFootprints cfg (bx.map some)).map (·.accepted))[i]! := by
  rw [checkBytes_body] at hbody
  cases hbody
  exact check_certifies S f0 a yy fi x bx B cfg boxes out ha hfi hty hcode hma hB hin

/-! ### From the spec to a page

A host (V8 in Chrome, WasmVM in Foafnaut, any engine) runs the page's call
`check(n, bps, boxes, out)` on its memory; `HostRun` is that, as a function from the
memory before to the memory after and the result. The theorems above are about the spec
semantics; these hypotheses carry them to a host, and nothing else is assumed. -/

/-- What the host does with one call: memory before, arguments; memory after, result. -/
structure HostRun where
  run : List Spec.byte → (n bps boxes out : Nat) → Option (List Spec.byte × Nat)

/-- The assumptions, as hypotheses (never `axiom`s):

(a) `spec`: the host instantiates `checkBytes` as the WebAssembly specification does and
runs the call as the spec semantics does. Instantiation: some store holds the function
whose code is the decoded body, at the type and local types the bytes declare, with the
memory the call sees; this includes that WasmVM's decoder and the opcode table `KI.toSpec`
give the bytes the binary format's meaning (the generated spec layer has no binary grammar
to prove that against). Running: if the spec relation reaches a result, the host returns
that result and memory. The spec is deterministic on this code (integers only: no float,
no host call, no `memory.grow`, no relaxed SIMD), which is what lets one reachable result
stand for the host's. WasmVM implements this and is tested against the official test
suite; V8 and the other browser engines are tested against the same suite.

(b) Floats: none. The kernel has no float instruction (`KI` has none), so NaN and
rounding cannot arise in it; the page's float positions become integers in the glue.

(c) `glue`: the page's glue writes the boxes as little-endian i32 at `boxes` and passes
the arguments unchanged (`Inputs`); it reads the flags back without changing them. -/
structure Bridge (host : HostRun) : Prop where
  spec : ∀ (B : List Spec.byte) (n bps boxes out : Nat),
    ∃ (S : Spec.store) (f0 : Spec.frame) (a : Nat) (yy : Spec.typeuse) (fi : Spec.funcinst) (x : Spec.idx),
      a < S.FUNCS.length ∧ S.FUNCS[a]! = fi ∧
      Spec.Expand fi.TYPE (.FUNC (.mk_list [.I32, .I32, .I32, .I32]) (.mk_list [.I32])) ∧
      (∃ body, decodedBody checkBytes = some body ∧
        fi.CODE = .FUNC x (checkLocalTypes.map .LOCAL) (KI.toSpecs body)) ∧
      fi.MODULE.MEMS[0]! < S.MEMS.length ∧ (S.MEMS[fi.MODULE.MEMS[0]!]!).BYTES = B ∧
      ∀ (S' : Spec.store) (r : Nat),
        Spec.Steps (.mk_config (.mk_state S f0)
            (vals [i32v n, i32v bps, i32v boxes, i32v out] ++ [.REF_FUNC_ADDR a, .CALL_REF yy]))
          (.mk_config (.mk_state S' f0) (vals [i32v r])) →
        host.run B n bps boxes out = some ((S'.MEMS[fi.MODULE.MEMS[0]!]!).BYTES, r)

/-- **What the page receives.** Under the bridge, a call of the verified kernel on boxes
the glue wrote returns `1` exactly when the Lean certificate `LayoutPolicy.certify`
accepts the layout, and then every node meets the overlap budget; the flags it leaves are
the certificate's per-node `accepted` fields. -/
theorem page_check_certifies (host : HostRun) (hb : Bridge host) (bx : List Box) (B : List Spec.byte)
    (cfg : UI.LayoutPolicy.Config) (boxes out : Nat) (hin : Inputs bx B bx.length cfg.overlapBps boxes out) :
    ∃ (B' : List Spec.byte) (r : Nat),
      host.run B bx.length cfg.overlapBps boxes out = some (B', r) ∧
      (r = 1 ↔ UI.LayoutPolicy.certify cfg (bx.map some) = true) ∧
      (r = 1 → UI.LayoutPolicy.LayoutAccepted cfg (bx.map some)) ∧
      ∀ i < bx.length, List.take 4 (List.drop (out + 4 * i) B') =
        flagBytes ((UI.LayoutPolicy.checkFootprints cfg (bx.map some)).map (·.accepted))[i]! := by
  obtain ⟨S, f0, a, yy, fi, x, ha, hfi, hty, ⟨body, hbody, hcode⟩, hma, hB, hrun⟩ :=
    hb.spec B bx.length cfg.overlapBps boxes out
  obtain ⟨S', r, hs, h1, h2, h3⟩ :=
    foaf_check_binary S f0 a yy fi x body bx B cfg boxes out hbody ha hfi hty hcode hma hB hin
  exact ⟨_, r, hrun S' r hs, h1, h2, h3⟩

end L4Factoidal.WasmVM.Proofs.FoafCheck
