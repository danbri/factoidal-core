  match load tailModule true with
  | .error e => IO.println s!"proposals tail calls: FAIL (load: {e})"; return false
  | .ok (st, ia) =>
    let small : Budget := { run := { maxDepth := 4, maxSlots := 64 } }
    let n : Nat := 1000000
    let t0 ← IO.monoNanosNow
    let r1 ← IO.lazyPure fun _ => call st ia "count" #[.i64 n.toUInt64, .i64 0] small
    let t1 ← IO.monoNanosNow
    let r2 := call st ia "even" #[.i64 (n + 1).toUInt64, .i64 0] small
    let r3 := call st ia "viaRef" #[.i64 n.toUInt64, .i64 0] small
    let r4 := call st ia "toHost" #[.i64 7] small
    let r5 := call st ia "countCall" #[.i64 n.toUInt64, .i64 0] small
    let checks := [("return_call", r1, i64s [n]), ("return_call_indirect", r2, i64s [n + n / 2 + 1]),
      ("return_call_ref", r3, i64s [3 * n]), ("return_call to a host function", r4, i64s [12]),
      ("call (control)", r5, "trap: call stack exhausted")]
    let mut ok := true
    for (what, got, want) in checks do
      if got != want then
        IO.println s!"  tail {what}: got {got}, expected {want}"
        ok := false
    IO.println s!"proposals tail calls: 10^6 tail calls at depth limit 4, 64 slots, {(t1 - t0) / 1000000} ms: {if ok then "pass" else "FAIL"}"
    return ok

/-- `try_table` costs no instruction when nothing is thrown. -/
def tryIsFree : IO Bool := do
  let .ok m := decode tryFreeModule | IO.println "proposals try_table cost: FAIL (decode)"; return false
  let .ok vm := validate m | IO.println "proposals try_table cost: FAIL (validate)"; return false
  let plain := vm.code[0]!.code
  let withTry := vm.code[1]!.code
  let same := withTry.size == plain.size + 1 &&
    (repr (withTry.extract 0 plain.size)).pretty == (repr plain).pretty &&
    (match withTry.back? with | some (.handlers hs) => hs.size == 1 | _ => false)
  let (st, r) := instantiateRun (M := ByteMem) (fun _ _ st => (st, .values #[])) {} vm #[]
  let .ok ia := r | IO.println "proposals try_table cost: FAIL (instantiate)"; return false
  let time := fun (name : String) => do
    let some (.func fa) := st.export? ia name | return (0, 0)
    let t0 ← IO.monoNanosNow
    let (_, _, steps) ← IO.lazyPure fun _ => invokeSteps st fa #[.i32 10000000] { fuel := 100000000000 }
    let t1 ← IO.monoNanosNow
    return (steps, (t1 - t0) / 1000000)
  let (s1, ms1) ← time "sumBlock"
  let (s2, ms2) ← time "sumTry"
  let ok := same && s1 == s2
  IO.println s!"proposals try_table cost: same ops as a block: {same}; 10^7 iterations: block {s1} instructions {ms1} ms, try_table {s2} instructions {ms2} ms: {if ok then "pass" else "FAIL"}"
  return ok

def run : IO Bool := do
  let a ← legacy
  let b ← tailConstantSpace
  let c ← tryIsFree
  return a && b && c

end L4Factoidal.WasmVM.Tests.Proposals
