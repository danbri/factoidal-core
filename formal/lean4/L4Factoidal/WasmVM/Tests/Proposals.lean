        (then (local.get 1))
        (else (call $countCall (i64.sub (local.get 0) (i64.const 1)) (i64.add (local.get 1) (i64.const 1))))))
    (table funcref (elem $even $odd))
    (func $even (export "even") (param i64 i64) (result i64)
