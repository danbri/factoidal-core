/-
L4Factoidal.WasmVM.Tests.Proposals: tests of exception handling (3.0 and legacy), tail
calls and typed function references (https://github.com/danbri/factoidal/issues/1244;
record: docs/designissues/2026-11-07-wasmvm-engine.md, "Exception handling", "Tail
calls").

Run by `lake exe wasmvm-spectest` (after the spec tests) and by
`lake exe wasmvm-bench proposals`. The spec tests cover `try_table`, `throw_ref`, the
tail calls and `call_ref`; they have no legacy `try`, so the legacy cases are here. The
modules were made by `wasm-tools parse` (1.263.0) from the text below, and the expected
values are what Node 22 (V8) gives for the same binaries.

`tailConstantSpace` runs 10^6 tail calls (`return_call`, `return_call_indirect`,
`return_call_ref`) with a call-depth limit of 4 and 64 operand slots: if a tail call
pushed a frame or kept its caller's slots, the run would stop with "call stack
exhausted". The same recursion with `call` must stop that way (the control).

`tryIsFree`: a loop inside `try_table` compiles to the same ops as the loop inside a
plain `block` (the only addition is the handler table after the last op), so code that
throws nothing runs the same instructions; the test checks the ops and prints the time
of both for 10^7 iterations.

`tryFreeModule` (the names section is in the binary; the engine skips it):

  (module
    (func (export "sumBlock") (param $n i32) (result i64) (local $i i32) (local $acc i64)
      (block $h (block
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $acc (i64.add (local.get $acc) (i64.extend_i32_u (local.get $i))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))))
      (local.get $acc))
    (func (export "sumTry") (param $n i32) (result i64) (local $i i32) (local $acc i64)
      (block $h (try_table (catch_all $h)
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $acc (i64.add (local.get $acc) (i64.extend_i32_u (local.get $i))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))))
      (local.get $acc))
  )

`legacyModule`:

  (module
    (tag $e (param i32))
    (tag $f)
    (func $thrower (param i32) (throw $e (local.get 0)))
    (func (export "catch") (param i32) (result i32)
      try (result i32)
        local.get 0 call $thrower i32.const 0
      catch $e
        i32.const 1 i32.add
      end)
    (func (export "catchall") (result i32)
      try (result i32) throw $f catch $e catch_all i32.const 7 end)
    (func (export "rethrow") (param i32) (result i32)
      try (result i32)
        try (result i32) local.get 0 throw $e catch $e drop rethrow 0 end
      catch $e i32.const 100 i32.add
      end)
    (func (export "delegate") (param i32) (result i32)
      try (result i32)
        try (result i32) local.get 0 throw $e delegate 0
      catch $e i32.const 1000 i32.add
      end)
    (func (export "delegate-out") (result i32)
      try (result i32)
        try (result i32) throw $f delegate 1
      catch_all i32.const 5
      end)
    (func (export "throw-in-catch") (result i32)
      try (result i32)
        try (result i32) throw $f catch_all i32.const 9 throw $e end
      catch $e
      end)
    (func (export "heights") (param i32) (result i32)
      i32.const 10
      try (result i32) i32.const 1 i32.const 2 local.get 0 throw $e catch $e end
      i32.add)
    (func (export "rethrow-depth") (result i32)
      try (result i32)
        try i32.const 3 throw $e catch $e drop block rethrow 1 end end
        i32.const 0
      catch $e
      end)
    (func (export "across") (param i32) (result i32)
      (block $h (result i32)
        (try_table (result i32) (catch $e $h) (call $thrower (local.get 0)) (i32.const -1))))
    (func (export "second-catch") (result i32)
      try (result i32) throw $f catch $e catch $f i32.const 21 catch_all i32.const 22 end)
    (func (export "no-throw") (result i32)
      try (result i32) i32.const 42 catch_all i32.const 0 end)
    (func (export "catch-results") (param i32) (result i32 i32)
      try (result i32 i32) local.get 0 throw $e catch $e i32.const 8 end)
    (func (export "delegate-to-block") (param i32) (result i32)
      try (result i32)
        block (result i32)
          try (result i32) local.get 0 throw $e delegate 0
        end
      catch $e i32.const 2000 i32.add
      end)
  )

`tailModule`:

  (module
    (type $t (func (param i64 i64) (result i64)))
    (import "host" "id" (func $hostId (param i64 i64) (result i64)))
    (func $count (export "count") (param i64 i64) (result i64)
      (if (result i64) (i64.eqz (local.get 0))
        (then (local.get 1))
        (else (return_call $count (i64.sub (local.get 0) (i64.const 1)) (i64.add (local.get 1) (i64.const 1))))))
    (func $countCall (export "countCall") (param i64 i64) (result i64)
