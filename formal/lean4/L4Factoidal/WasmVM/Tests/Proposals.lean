/-- The host of `tailModule`: function 0 adds its two i64 arguments. -/
def tailHost : PureHost ByteMem := fun _ args st =>
  match args with
  | #[.i64 a, .i64 b] => (st, .values #[.i64 (a + b)])
  | _ => (st, .trap "bad arguments")

/-- Decode, validate and instantiate `bytes`; for `tailModule` the host function is
the one import. -/
def load (bytes : ByteArray) (withHost : Bool) : Except String (Store × Nat) := do
  let m ← (decode bytes).mapError (·.toString)
  let vm ← (validate m).mapError (·.toString)
  let (st, imps) := if withHost then
      let (st, a) := ({} : Store).addHostFunc ⟨#[.i64, .i64], #[.i64]⟩ 0
      (st, #[ExternVal.func a])
    else (({} : Store), #[])
  let (st, r) := instantiateRun tailHost st vm imps
  match r with
  | .ok ia => .ok (st, ia)
  | .error e => .error e.toString

/-- Run export `name` and describe the outcome. -/
def call (st : Store) (ia : Nat) (name : String) (args : Array Value) (lim : Budget := {}) : String :=
  match st.export? ia name with
  | some (.func fa) =>
    match invokePure tailHost st fa args lim with
    | (_, .values vs) => s!"values {repr vs}"
    | (_, .exception _ _) => "exception"
    | (_, o) => o.describe
  | _ => s!"no export {name}"

def i32s (vs : List Int) : String :=
  s!"values {repr (vs.toArray.map fun v => Value.i32 (UInt32.ofNat (v % 4294967296).toNat))}"
def i64s (vs : List Nat) : String := s!"values {repr (vs.toArray.map fun v => Value.i64 v.toUInt64)}"

/-- (export, arguments, expected outcome) for `legacyModule`. -/
def legacyCases : List (String × Array Value × String) :=
  [("catch", #[.i32 5], i32s [6]),
   ("catchall", #[], i32s [7]),
   ("rethrow", #[.i32 4], i32s [104]),
   ("delegate", #[.i32 3], i32s [1003]),
   ("delegate-out", #[], "exception"),
   ("throw-in-catch", #[], i32s [9]),
   ("heights", #[.i32 6], i32s [16]),
   ("rethrow-depth", #[], i32s [3]),
   ("across", #[.i32 11], i32s [11]),
   ("second-catch", #[], i32s [21]),
   ("no-throw", #[], i32s [42]),
   ("catch-results", #[.i32 3], i32s [3, 8]),
   ("delegate-to-block", #[.i32 7], i32s [2007])]

def legacy : IO Bool := do
  match load legacyModule false with
  | .error e => IO.println s!"proposals legacy exceptions: FAIL (load: {e})"; return false
  | .ok (st, ia) =>
    let mut ok := true
    for (name, args, want) in legacyCases do
      let got := call st ia name args
      if got != want then
        IO.println s!"  legacy {name}: got {got}, expected {want}"
        ok := false
    IO.println s!"proposals legacy exceptions: {legacyCases.length} cases: {if ok then "pass" else "FAIL"}"
    return ok

