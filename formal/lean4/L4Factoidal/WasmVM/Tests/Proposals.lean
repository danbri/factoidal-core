        (then (local.get 1))
        (else (return_call_indirect (type $t) (i64.sub (local.get 0) (i64.const 1)) (i64.add (local.get 1) (i64.const 2)) (i32.const 0)))))
    (elem declare func $viaRef)
    (func $viaRef (export "viaRef") (param i64 i64) (result i64)
      (if (result i64) (i64.eqz (local.get 0))
        (then (local.get 1))
        (else (return_call_ref $t (i64.sub (local.get 0) (i64.const 1)) (i64.add (local.get 1) (i64.const 3)) (ref.func $viaRef)))))
    (func (export "toHost") (param i64) (result i64)
      (local i64 i64 i64)
