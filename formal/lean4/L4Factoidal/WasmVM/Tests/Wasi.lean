/-- The function each case `k` of `wasi_all.c`'s `call` calls (the declaration order
of Emscripten's `wasi/api.h`). -/
def allOrder : List String :=
  ["args_get", "args_sizes_get", "environ_get", "environ_sizes_get", "clock_res_get",
   "clock_time_get", "fd_advise", "fd_allocate", "fd_close", "fd_datasync", "fd_fdstat_get",
   "fd_fdstat_set_flags", "fd_fdstat_set_rights", "fd_filestat_get", "fd_filestat_set_size",
   "fd_filestat_set_times", "fd_pread", "fd_prestat_get", "fd_prestat_dir_name", "fd_pwrite",
   "fd_read", "fd_readdir", "fd_renumber", "fd_seek", "fd_sync", "fd_tell", "fd_write",
   "path_create_directory", "path_filestat_get", "path_filestat_set_times", "path_link",
   "path_open", "path_readlink", "path_remove_directory", "path_rename", "path_symlink",
   "path_unlink_file", "poll_oneoff", "proc_exit", "proc_raise", "sched_yield", "random_get",
   "sock_recv", "sock_send", "sock_shutdown"]

/-- Pass/fail bookkeeping. -/
structure Check where
  ok : Bool := true
  fails : Array String := #[]
  count : Nat := 0

def Check.expect (c : Check) (what : String) (cond : Bool) (detail : String := "") : Check :=
  { c with count := c.count + 1, ok := c.ok && cond,
           fails := if cond then c.fails else c.fails.push s!"{what} {detail}" }

def errnoOf : Outcome → Option Nat
  | .values #[.i32 v] => some v.toNat
  | _ => none

/-- The errno function `f` answers with no capabilities and zero arguments. -/
def expectedZero (f : Fn) : Outcome → Bool := fun o =>
  match f with
  | .args_get | .args_sizes_get | .environ_get | .environ_sizes_get | .fd_fdstat_get
  | .sched_yield => errnoOf o == some 0
  | .clock_res_get | .clock_time_get | .random_get => errnoOf o == some 76
  | .fd_write => errnoOf o == some 8
  | .proc_exit => match o with | .exit 0 => true | _ => false
  | f => errnoOf o == some f.denyErrno.toNat

/-- Part 0: the function table. -/
def table : Check :=
  let c : Check := {}
  let c := c.expect "46 functions" (Fn.all.length == 46)
  let c := c.expect "names round-trip" (Fn.all.all fun f => Fn.ofName? f.name == some f)
  let prefixed := Fn.all.filter fun f => f.name.startsWith "path_" || f.name.startsWith "sock_"
  let c := c.expect "pathSock is the path_ and sock_ functions" (prefixed == pathSock)
  let witx := allOrder ++ ["sock_accept"]
  c.expect "allOrder and sock_accept are the 46 names" (witx.length == 46 && Fn.all.all fun f => witx.contains f.name)

/-- Part 1. -/
def allImports : IO Check := do
  let mut c : Check := {}
  match ← load ({} : Caps IO) allModule with
  | .error e => return c.expect "wasi_all links" false e
  | .ok l =>
    c := c.expect "wasi_all: 45 imports linked to Preview 1 functions" (l.bindings.size == 45 &&
      l.bindings.all fun b => match b with | .wasi _ => true | _ => false)
    let (l, _) ← l.run {} "_initialize" #[]
    for (name, k) in allOrder.zipIdx do
      let some f := Fn.ofName? name | c := c.expect name false "not a function"
      let (_, o) ← l.run {} "call" #[.i32 k.toUInt32]
      c := c.expect s!"wasi_all {name} with no capabilities" (expectedZero f o) o.describe
    return c

def rd (l : Loaded) (off n : Nat) : ByteArray := (l.store.readMem l.mem off n).toOption.getD .empty
def wr (l : Loaded) (off : Nat) (b : ByteArray) : Loaded :=
  { l with store := (l.store.writeMem l.mem off b).toOption.getD l.store }
def bytes (s : String) : ByteArray := s.toUTF8

/-- Part 2. -/
def hand : IO Check := do
  let mut c : Check := {}
  let out ← IO.mkRef ByteArray.empty
  let err ← IO.mkRef ByteArray.empty
  -- Deterministic test randomness (seed 42), NOT random.
  let rnd ← seededRandom 42
  let caps : Caps IO := {
    args := #["prog", "a", "héllo"], env := #["A=1", "EMPTY="],
    clock := fun id => if id == 1 then some (pure 123456789) else none,
    clockRes := fun id => if id == 1 then some 1000 else none,
    random := some rnd, stdout := some (capture out), stderr := some (capture err) }
  let .ok l ← load caps handModule | return c.expect "wasi_hand loads" false
  let call := fun (l : Loaded) (name : String) (args : List Nat) => do
    let (_, o) ← l.run caps name (args.toArray.map fun a => .i32 a.toUInt32)
    pure o
  let run := fun (l : Loaded) (name : String) (args : Array Value) => l.run caps name args
  -- args
  let (l, o) ← run l "args_sizes_get" #[.i32 100, .i32 104]
  c := c.expect "args_sizes_get" (errnoOf o == some 0 && rd l 100 8 == le32 3 ++ le32 14) s!"{(rd l 100 8).toList}"
  let (l, o) ← run l "args_get" #[.i32 200, .i32 300]
  c := c.expect "args_get pointers" (errnoOf o == some 0 && rd l 200 12 == le32 300 ++ le32 305 ++ le32 307)
  c := c.expect "args_get strings" (rd l 300 14 == bytes "prog\x00a\x00héllo\x00")
  -- environ
  let (l, o) ← run l "environ_sizes_get" #[.i32 100, .i32 104]
  c := c.expect "environ_sizes_get" (errnoOf o == some 0 && rd l 100 8 == le32 2 ++ le32 11)
  let (l, o) ← run l "environ_get" #[.i32 400, .i32 420]
  c := c.expect "environ_get" (errnoOf o == some 0 && rd l 400 8 == le32 420 ++ le32 424 &&
    rd l 420 11 == bytes "A=1\x00EMPTY=\x00")
  -- clocks
  let (l, o) ← run l "clock_time_get" #[.i32 1, .i64 0, .i32 500]
  c := c.expect "clock_time_get monotonic" (errnoOf o == some 0 && rd l 500 8 == le64 123456789)
  c := c.expect "clock_time_get realtime not granted: ENOTCAPABLE" (errnoOf (← l.run caps "clock_time_get" #[.i32 0, .i64 0, .i32 500]).2 == some 76)
  c := c.expect "clock_time_get id 9: EINVAL" (errnoOf (← l.run caps "clock_time_get" #[.i32 9, .i64 0, .i32 500]).2 == some 28)
  c := c.expect "clock_time_get bad pointer: EFAULT" (errnoOf (← l.run caps "clock_time_get" #[.i32 1, .i64 0, .i32 65532]).2 == some 21)
  let (l, o) ← run l "clock_res_get" #[.i32 1, .i32 508]
  c := c.expect "clock_res_get" (errnoOf o == some 0 && rd l 508 8 == le64 1000)
  -- random (seeded: deterministic)
  let (l, o) ← run l "random_get" #[.i32 600, .i32 20]
  let want ← (← seededRandom 42) 20
  c := c.expect "random_get (seed 42, deterministic)" (errnoOf o == some 0 && rd l 600 20 == want)
  c := c.expect "random_get out of bounds: EFAULT" (errnoOf (← call l "random_get" [65530, 16]) == some 21)
  -- fd_write: iovs at 700 = (800, 5), (810, 6)
  let l := wr (wr (wr l 700 (le32 800 ++ le32 5 ++ le32 810 ++ le32 6)) 800 (bytes "hello")) 810 (bytes " world")
  let (l, o) ← run l "fd_write" #[.i32 1, .i32 700, .i32 2, .i32 720]
  c := c.expect "fd_write fd 1" (errnoOf o == some 0 && rd l 720 4 == le32 11 && (← out.get) == bytes "hello world")
  let (l, o) ← run l "fd_write" #[.i32 2, .i32 700, .i32 1, .i32 720]
  c := c.expect "fd_write fd 2" (errnoOf o == some 0 && rd l 720 4 == le32 5 && (← err.get) == bytes "hello")
  c := c.expect "fd_write fd 3: EBADF" (errnoOf (← call l "fd_write" [3, 700, 2, 720]) == some 8)
  c := c.expect "fd_write fd 0: EBADF" (errnoOf (← call l "fd_write" [0, 700, 2, 720]) == some 8)
  let l := wr l 730 (le32 65530 ++ le32 100)
  c := c.expect "fd_write iov out of bounds: EFAULT, nothing written" (errnoOf (← call l "fd_write" [1, 730, 1, 720]) == some 21 && (← out.get) == bytes "hello world")
  -- fd_fdstat_get
  let (l, o) ← run l "fd_fdstat_get" #[.i32 1, .i32 900]
  c := c.expect "fd_fdstat_get fd 1" (errnoOf o == some 0 && rd l 900 24 == ⟨#[2, 0, 0, 0, 0, 0, 0, 0]⟩ ++ le64 64 ++ le64 0)
  let (l, o) ← run l "fd_fdstat_get" #[.i32 0, .i32 900]
  c := c.expect "fd_fdstat_get fd 0" (errnoOf o == some 0 && rd l 900 24 == ⟨#[2, 0, 0, 0, 0, 0, 0, 0]⟩ ++ le64 0 ++ le64 0)
  c := c.expect "fd_fdstat_get fd 3: EBADF" (errnoOf (← call l "fd_fdstat_get" [3, 900]) == some 8)
  -- denied: errno, and memory unchanged
  let l := wr l 1000 (bytes "/etc/passwd")
  let before := rd l 0 65536
  let checks : List (String × List Nat × Nat) :=
    [("path_open", [1000, 11], 76), ("fd_read", [0, 700, 1, 720], 8), ("fd_prestat_get", [3, 0], 8),
     ("poll_oneoff", [], 52), ("sock_send", [], 76)]
  for (name, args, want) in checks do
    let (l', o) ← l.run caps name (args.toArray.map fun a => .i32 a.toUInt32)
    c := c.expect s!"{name}: errno {want}, memory unchanged" (errnoOf o == some want && rd l' 0 65536 == before) o.describe
  c := c.expect "sched_yield" (errnoOf (← call l "sched_yield" []) == some 0)
  let o ← call l "proc_exit" [7]
  c := c.expect "proc_exit 7" (match o with | .exit 7 => true | _ => false) o.describe
  -- no capabilities at all
  let none : Caps IO := {}
  c := c.expect "no capabilities: fd_write ENOTCAPABLE" (errnoOf (← l.run none "fd_write" #[.i32 1, .i32 700, .i32 2, .i32 720]).2 == some 76)
  c := c.expect "no capabilities: random_get ENOTCAPABLE" (errnoOf (← l.run none "random_get" #[.i32 600, .i32 20]).2 == some 76)
  c := c.expect "no capabilities: args_sizes_get gives 0, 0" (← do
    let (l', o) ← l.run none "args_sizes_get" #[.i32 100, .i32 104]
    pure (errnoOf o == some 0 && rd l' 100 8 == le32 0 ++ le32 0))
  return c

/-- Part 3. -/
def linkErrors : IO Check := do
  let mut c : Check := {}
  for (name, b) in [("wrong type", badtypeModule), ("not a Preview 1 name", badnameModule)] do
    match ← load {} b with
    | .error e => c := c.expect s!"{name}: link error" (e.startsWith "link:") e
    | .ok _ => c := c.expect s!"{name}: link error" false "linked"
  return c

/-- Part 4: the vendored wasi-testsuite subset. -/
def testsuite (dir : System.FilePath := "../../third_party/wasi-testsuite") : IO Check := do
  let mut c : Check := {}
  for sub in ["assemblyscript", "c"] do
    let files ← (dir / sub).readDir
    let wasms := (files.filter (·.path.extension == some "wasm")).map (·.path)
    for p in wasms.insertionSort (·.toString < ·.toString) do
      let stem := p.fileStem.getD ""
      let specPath := p.withExtension "json"
      let spec ← if ← specPath.pathExists then
          match Lean.Json.parse (← IO.FS.readFile specPath) with
          | .ok j => pure j
          | .error e => c := c.expect s!"{sub}/{stem} spec" false e; pure Lean.Json.null
        else pure Lean.Json.null
      let args := match spec.getObjValAs? (Array String) "args" with | .ok a => a | .error _ => #[]
      let env := match spec.getObjVal? "env" with
        | .ok (.obj kvs) => kvs.toArray.filterMap fun (k, v) => match v with | .str s => some s!"{k}={s}" | _ => none
        | _ => #[]
      let wantExit := match spec.getObjValAs? Nat "exit_code" with | .ok n => n | .error _ => 0
      let wantOut := (spec.getObjValAs? String "stdout").toOption
      let wantErr := (spec.getObjValAs? String "stderr").toOption
      let out ← IO.mkRef ByteArray.empty
      let err ← IO.mkRef ByteArray.empty
      let argv := #[p.fileName.getD "test.wasm"] ++ args
      let caps : Caps IO := {
        args := argv, env := env, clock := systemClock, clockRes := systemClockRes,
        random := some systemRandom, stdout := some (capture out), stderr := some (capture err) }
      let t0 ← IO.monoNanosNow
      match ← load caps (← IO.FS.readBinFile p) with
      | .error e => c := c.expect s!"{sub}/{stem}" false e
      | .ok l =>
        let (_, o) ← l.run caps "_start" #[]
        let t1 ← IO.monoNanosNow
        let code := match o with | .values _ => some 0 | .exit s => some s | _ => none
        let so := String.fromUTF8? (← out.get) |>.getD "<not UTF-8>"
        let se := String.fromUTF8? (← err.get) |>.getD "<not UTF-8>"
        let ok := code == some wantExit && wantOut.all (· == so) && wantErr.all (· == se)
        c := c.expect s!"{sub}/{stem}" ok s!"({o.describe}; stdout {repr so}; stderr {repr se})"
        IO.println s!"  wasi-testsuite {sub}/{stem}: {if ok then "pass" else "FAIL"} ({(t1 - t0) / 1000000} ms)"
  return c

def run : IO Bool := do
  let parts : List (String × Check) := [("function table", table), ("45 imports from wasi/api.h", ← allImports),
    ("granted and denied functions", ← hand), ("link errors", ← linkErrors), ("wasi-testsuite subset", ← testsuite)]
  let mut ok := true
  for (name, c) in parts do
    for f in c.fails do IO.println s!"  wasi {name}: FAIL {f}"
    IO.println s!"wasi {name}: {c.count} checks: {if c.ok then "pass" else "FAIL"}"
    ok := ok && c.ok
  return ok

end L4Factoidal.WasmVM.Tests.Wasi
