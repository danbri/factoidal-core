set_option maxHeartbeats 4000000
set_option linter.unusedVariables false

theorem genUnwind_step {H : Type} (n m : Nat) (ih : IH H n m) (a0 : List GFrame) (a1 : GCompl) :
    Le (genUnwind (H := H) (n + 1) a0 a1) (genUnwind (m + 1) a0 a1) := by
  refine Le.unfold (genUnwind.eq_def _ _ _) (genUnwind.eq_def _ _ _) ?_
  fuel_walk ih

end L4Factoidal.JS.FuelMono
