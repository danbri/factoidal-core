private def shaOf (w : ByteArray) : Option (Nat × String) :=
  (toSfnt w).toOption.map fun s => (s.size, bytesToHex (sha256 s))

-- The sfnt of each file is google/woff2's.
#guard shaOf w_plain == some (1244, "84915e01f8cb144cde06c4093372f99972462273188b43f8d84893b948279194")
#guard shaOf w_glyf == some (1248, "5700187a0428b5c5cc44b09fa6b3af0c8b55aac375250bb7e1547cf9561d5c0c")
#guard shaOf w_hmtx == some (1248, "5700187a0428b5c5cc44b09fa6b3af0c8b55aac375250bb7e1547cf9561d5c0c")
-- The font reader's directory check takes it: 13 tables, distinct tags, all inside the file.
#guard match toSfnt w_hmtx with
  | .ok s => match FontPolicy.readDirectory s with
    | .ok dir => dir.size == 13
    | .error _ => false
  | .error _ => false
-- The whole font sums to 0xB1B0AFBA (head checkSumAdjustment).
#guard match toSfnt w_glyf with
  | .ok s => checksum s 0 s.size == 0xB1B0AFBA
  | .error _ => false
-- sfntOf: WOFF2 and WOFF 1.0 are decoded, other bytes pass.
#guard (sfntOf w_glyf).toOption.map (·.size) == some 1248
#guard (sfntOf "true".toUTF8).toOption.map (·.toList) == some "true".toUTF8.toList

/-! ## Refusals -/

private def setU32 (b : ByteArray) (i v : Nat) : ByteArray :=
  b.set! i (v / 16777216 % 256).toUInt8 |>.set! (i+1) (v / 65536 % 256).toUInt8
    |>.set! (i+2) (v / 256 % 256).toUInt8 |>.set! (i+3) (v % 256).toUInt8

-- Not WOFF2; shorter than the header; the length field is not the file's length.
#guard (toSfnt "wOFF".toUTF8).toOption.isNone
#guard (toSfnt (w_plain.extract 0 40)).toOption.isNone
#guard (toSfnt (w_plain.extract 0 (w_plain.size - 1))).toOption.isNone
#guard (toSfnt (setU32 w_plain 8 (w_plain.size + 4))).toOption.isNone
-- A collection; no tables.
#guard (toSfnt (setU32 w_plain 4 0x74746366)).toOption.isNone
#guard (toSfnt (w_plain.set! 12 0 |>.set! 13 0)).toOption.isNone
-- totalCompressedSize one byte short: the Brotli stream is cut, or the layout check fails.
#guard (toSfnt (setU32 w_glyf 20 (((w_glyf.get! 20).toNat * 16777216 + (w_glyf.get! 21).toNat * 65536 +
  (w_glyf.get! 22).toNat * 256 + (w_glyf.get! 23).toNat) - 1))).toOption.isNone
-- Bytes after the font data that the header does not account for.
#guard (toSfnt (setU32 (w_plain ++ bytes [0, 0, 0, 0]) 8 (w_plain.size + 4))).toOption.isNone
-- Each byte from 48 to 199 inverted in turn (the directory and the start of the Brotli stream):
-- a refusal, or a font that is not the original; never a panic.
#guard (List.range 152).all fun k =>
  let i := 48 + k
  match toSfnt (w_glyf.set! i (w_glyf.get! i ^^^ 0xFF)) with
  | .ok s => bytesToHex (sha256 s) != "5700187a0428b5c5cc44b09fa6b3af0c8b55aac375250bb7e1547cf9561d5c0c"
  | .error _ => true

end L4Factoidal.Rendering.Woff2
