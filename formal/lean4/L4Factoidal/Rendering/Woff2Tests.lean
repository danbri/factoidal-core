/-
L4Factoidal.Rendering.Woff2Tests -- the build-time checks of `L4Factoidal.Rendering.Woff2`.

The fixtures are top-level constants, so they live here and not in the reader (see the header
of `Codec.InflateTests`); this module is imported by the umbrella `L4Factoidal` only.

The three WOFF2 files are Noto Sans Regular (SIL Open Font License 1.1, no Reserved Font Name;
third_party/fonts/noto-sans/OFL.txt) cut by fontTools to the glyphs of "Aé1" (six glyphs: an
empty .notdef, four simple glyphs, and the composite eacute), then written by fontTools as
WOFF2 with no transform, with `glyf` and `loca` transformed, and with `hmtx` transformed too
(`python3 tools/fonts/woff2_vectors.py lean <dir>` prints them). The expected SHA-256 values
are of the sfnt that google/woff2's `woff2_decompress` (master, built with google/brotli
1.1.0) makes from the same files. The larger comparison, 34 files from twelve fonts against
fontTools and against `woff2_decompress`, is `tools/fonts/woff2_vectors.py`.
-/
import L4Factoidal.Rendering.Woff2
import L4Factoidal.Rendering.FontPolicy
import L4Factoidal.Crypto.SHA2

namespace L4Factoidal.Rendering.Woff2

open L4Factoidal.Crypto

private def bytes (xs : List Nat) : ByteArray := ByteArray.mk (xs.map UInt8.ofNat).toArray

/-! ## Variable-length numbers (§4.1) -/

private def b128 (xs : List Nat) : Option Nat :=
  ((⟨0, xs.length⟩ : Cur).base128 (bytes xs) "test").toOption.map (·.1)
#guard b128 [0x3F] == some 63
#guard b128 [0x81, 0x00] == some 128
#guard b128 [0x8F, 0xFF, 0xFF, 0xFF, 0x7F] == some 4294967295
#guard b128 [0x80, 0x01] == none
#guard b128 [0x90, 0x80, 0x80, 0x80, 0x00] == none
#guard b128 [0x81, 0x80, 0x80, 0x80, 0x80, 0x00] == none
#guard b128 [0x81] == none

private def u255 (xs : List Nat) : Option Nat :=
  ((⟨0, xs.length⟩ : Cur).r255 (bytes xs) "test").toOption.map (·.1)
#guard u255 [252] == some 252
#guard u255 [255, 0] == some 253
#guard u255 [254, 0] == some 506
#guard u255 [255, 255] == some 508
#guard u255 [253, 0x01, 0x00] == some 256
#guard u255 [253, 0x01] == none

/-! ## Triplets (§5.2) and the simple-glyph encoding -/

-- flags then triplet bytes: flag 1 (dy = +b), flag 10 (dx = -b), flag 127 (dx, dy 16 bits each,
-- both positive), flag 128+20 (an off-curve point, dx and dy from one byte's nibbles)
private def tripletData : ByteArray := bytes [1, 10, 127, 148, 5, 7, 0x01, 0x00, 0x00, 0x10, 0x34]
#guard match tripletDecode tripletData 0 4 ⟨4, 11⟩ with
  | .ok (pts, c) => c.pos == 11 &&
      (pts.toList.map fun p => (p.x, p.y, p.onCurve)) ==
        [(0, 5, true), (-7, 5, true), (249, 21, true), (245, 16, false)]
  | .error _ => false
-- too few triplet bytes
#guard (tripletDecode tripletData 0 4 ⟨4, 10⟩).toOption.isNone

-- Three points: the second and third have the same flag (repeat folded), the first has a
-- 16-bit x.
#guard (storePoints #[⟨300, 0, true⟩, ⟨301, 1, true⟩, ⟨302, 2, true⟩] false).toList ==
  [0x21, 0x3F, 0x01, 0x01, 0x2C, 0x01, 0x01, 0x01, 0x01]
-- The overlap bit (OVERLAP_SIMPLE, 0x40) goes on the first flag only.
#guard (storePoints #[⟨0, 0, false⟩] true).toList == [0x70]

