/-
L4Factoidal.XPath4.Tz — civil time zones from the IANA database
(`TzData.lean`, generated by `tools/xpath4/gen-tzdata.py`) and
`fn:civil-timezone` (F&O 4.0 §9.7.4).

Rules implemented from the spec text (read 2026-10-28):
* `$place` is an IANA zone name. A name that is not in the database
  raises FODT0004; so does an instant outside 1900 to 2100 (the range
  the generated tables cover).
* An empty `$place` selects the default place of the dynamic context.
  This processor has no default-place setting; its default place is a
  place whose offset is always the implicit timezone, so the result is
  the implicit timezone (`Env.tz`).
* A `$value` with no timezone is read in the implicit timezone.

`fn:format-dateTime` uses `placeAdjust` to move a dateTime to the civil
time of a recognised zone (§9.9.4.3), and the abbreviation for the `N`
timezone presentation.
-/
import L4Factoidal.XPath4.Lib
import L4Factoidal.XPath4.TzData

namespace L4Factoidal.XPath4

open L4Factoidal.XSD

/-- A parsed zone: the states `(offset seconds, abbreviation)` and the
    transitions `(UTC instant, state index)`, ascending by instant. -/
structure TzZone where
  states : Array (Int × String)
  trans : Array (Int × Nat)
deriving Inhabited

/-- Base-36 digits (lower case) to a natural number. -/
def b36Nat (s : String) : Nat :=
  s.foldl (fun acc c =>
    let d := if c.isDigit then c.toNat - 48 else c.toNat - 87
    acc * 36 + d) 0

def parseState (s : String) : Int × String :=
  match s.splitOn "," with
  | [o, a] =>
    let neg := o.startsWith "-"
    let n := (if neg then (o.drop 1).toString else o).toNat!
    ((if neg then -(n : Int) else n), a)
  | _ => (0, "")

/-- Parse a `states|transitions` table of `TzData`. -/
def parseTzTable (t : String) : TzZone :=
  match t.splitOn "|" with
  | [st, tr] =>
    let states := (st.splitOn ";").toArray.map parseState
    let toks := (tr.splitOn " ").filter (· != "")
    let (_, rev) := toks.foldl (fun (acc : Int × List (Int × Nat)) tok =>
      match tok.splitOn "." with
      | [d, i] =>
        let at_ := acc.1 + (b36Nat d : Int)
        (at_, (at_, b36Nat i) :: acc.2)
      | _ => acc) (tzBase, [])
    { states, trans := rev.reverse.toArray }
  | _ => default

/-- The table index of a zone name, from `tzZoneIndex`. -/
def tzIndexOf (name : String) : Option Nat :=
  (tzZoneIndex.splitOn "\n").findSome? fun l =>
    match l.splitOn "=" with
    | [n, k] => if n == name then some k.toNat! else none
    | _ => none

def findZone (name : String) : Option TzZone :=
  (tzIndexOf name).bind fun k => (tzTables[k]?).map parseTzTable

/-- The index of the last transition at or before `t`, by binary
    search; `none` when `t` is before the first one. -/
def lastAtOrBefore (trans : Array (Int × Nat)) (t : Int) : Option Nat :=
  if trans.size = 0 then none else Id.run do
  let mut lo := 0          -- every index below lo has instant <= t
  let mut hi := trans.size -- every index from hi on has instant > t
  for _ in [0:64] do
    if lo < hi then
      let mid := (lo + hi) / 2
      match trans[mid]? with
      | some (x, _) => if x ≤ t then lo := mid + 1 else hi := mid
      | none => hi := mid
  pure (if lo == 0 then none else some (lo - 1))

/-- The state `(offset seconds, abbreviation)` of the zone at the UTC
    instant `t` (seconds from the Unix epoch). -/
def TzZone.at (z : TzZone) (t : Int) : Option (Int × String) :=
  match lastAtOrBefore z.trans t with
  | none => z.states[0]?
  | some i => (z.trans[i]?).bind fun (_, s) => z.states[s]?

/-- The first and last instant the tables cover. -/
def tzCoverEnd : Int := 4102444800  -- 2100-01-01T00:00:00Z

/-- A zone with no transitions: the empty table has no state. -/
theorem TzZone.at_empty (t : Int) :
    ({ states := #[], trans := #[] } : TzZone).at t = none := by
  simp [TzZone.at, lastAtOrBefore]

/-- The UTC instant, in seconds from the Unix epoch, of a dateTime value
    (a value with no timezone is read in `implicitMin` minutes). -/
def dtUtcSeconds (v : DTValue) (implicitMin : Int) : Int :=
  let days := daysFromCivil (v.year.getD 0) (v.month.getD 1) (v.day.getD 1)
  let secs := (v.second.getD Dec.zero).floorDiv
  days * 86400 + (v.hour.getD 0 : Int) * 3600 + (v.minute.getD 0 : Int) * 60 + secs
    - (v.tz.getD implicitMin) * 60

/-- The civil state of `place` at the instant, or `none` when the place
    is unknown or the instant is outside 1900 to 2100. -/
def civilStateAt (place : String) (t : Int) : Option (Int × String) :=
  if t < tzBase || t ≥ tzCoverEnd then none
  else (findZone place).bind (·.at t)

/-- The dateTime adjusted to the civil time of a recognised place, with
    the zone abbreviation. `none` when the place is not recognised or
    the value has no timezone or no full date and time. -/
def placeAdjust (v : DTValue) (place : String) : Option (DTValue × String) :=
  match v.tz, v.year, v.month, v.day, v.hour with
  | some _, some _, some _, some _, some _ =>
    let t := dtUtcSeconds v 0
    match civilStateAt place t with
    | none => none
    | some (off, abbr) =>
      let local_ := t + off
      let days := Int.fdiv local_ 86400
      let rest := local_ - days * 86400
      let (y, m, d) := L4Factoidal.Fn.DateTime.civilFromDays days
      let frac := Dec.add (v.second.getD Dec.zero) (Dec.ofInt (-(Dec.floorDiv (v.second.getD Dec.zero))))
      some ({ v with year := some y, month := some m, day := some d,
                     hour := some (rest / 3600).toNat, minute := some ((rest % 3600) / 60).toNat,
                     second := some (Dec.add (Dec.ofInt (rest % 60)) frac),
                     tz := some (off / 60) }, abbr)
  | _, _, _, _, _ => none

def civilTimezoneFn : LibFn := fun _ e a => do
  match optAtom (argN a 0) with
  | none => err "XPTY0004" "civil-timezone needs an xs:dateTime"
  | some x =>
    match x.v with
    | .x (.dt _ v) =>
      let mkDur (m : Int) : Seq :=
        [.atom ⟨.b .dayTimeDuration, .x (.dur { months := 0, seconds := Dec.ofInt (m * 60) })⟩]
      match optAtom (argN a 1) with
      | none => pure (mkDur e.tz)
      | some p =>
        match civilStateAt p.str (dtUtcSeconds v e.tz) with
        | some (off, _) => pure (mkDur (off / 60))
        | none => err "FODT0004" ("no timezone information for place " ++ p.str ++ " at the given time")
    | _ => err "XPTY0004" "civil-timezone needs an xs:dateTime"

def tzTable : List (String × LibFn) := [("civil-timezone", civilTimezoneFn)]

/-! ## Tests -/

private def tzAt (p : String) (y : Int) (m d : Nat) : Option Int :=
  (civilStateAt p (daysFromCivil y m d * 86400 + 43200)).map (·.1)

#guard tzAt "Europe/London" 2024 7 1 == some 3600
#guard tzAt "Europe/London" 2024 1 1 == some 0
#guard tzAt "America/New_York" 2024 1 15 == some (-18000)
#guard tzAt "America/New_York" 2024 7 15 == some (-14400)
#guard tzAt "Europe/Paris" 2024 11 5 == some 3600
#guard tzAt "Europe/Paris" 2024 5 5 == some 7200
#guard tzAt "Asia/Kolkata" 2024 5 5 == some 19800
#guard tzAt "America/Lima" 2024 5 5 == some (-18000)
#guard tzAt "North/Pole" 2024 5 5 == none
#guard tzAt "Europe/Paris" 2150 5 5 == none
#guard (civilStateAt "America/New_York" (daysFromCivil 2015 2 15 * 86400 + 43200)).map (·.2) == some "EST"
#guard (civilStateAt "Europe/Paris" (daysFromCivil 2015 8 15 * 86400 + 43200)).map (·.2) == some "CEST"
-- the transition itself: London 2024-03-31T01:00:00Z is the first instant of BST
#guard (civilStateAt "Europe/London" (daysFromCivil 2024 3 31 * 86400 + 3600)).map (·.1) == some 3600
#guard (civilStateAt "Europe/London" (daysFromCivil 2024 3 31 * 86400 + 3599)).map (·.1) == some 0

end L4Factoidal.XPath4
