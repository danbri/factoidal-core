/-
Soundness of the actual static analyser against the actual evaluator, for a
closed fragment of atomic literals, two-literal sequences, empty expressions,
singleton sequences, and conditionals with an empty branch. Tests are unrestricted;
successful inference must check them and successful evaluation must select a
branch. This is not whole-language soundness. In particular, arbitrary
concatenation and two nonempty conditional branches build nested choice types
and need a separate bound for Core's fuel-bounded public sequence matcher.
-/
import L4Factoidal.XPath4.StaticTyping
import L4Factoidal.XPath4.Eval

namespace L4Factoidal.XPath4.StaticTyping

/-- Syntactic admission does not assume any evaluation or typing result. -/
inductive Fragment : Expr → Prop where
  | literal (a : Atomic) : Fragment (.lit a)
  | pair (a b : Atomic) : Fragment (.seq [.lit a, .lit b])
  | empty : Fragment (.seq [])
  | singleton {e : Expr} : Fragment e → Fragment (.seq [e])
  | thenEmpty (c : Expr) {e : Expr} : Fragment e → Fragment (.ifE c e (.seq []))
  | elseEmpty (c : Expr) {e : Expr} : Fragment e → Fragment (.ifE c (.seq []) e)

/-- Types generated by the fragment, including the analyser's fuel fallback. -/
inductive FlatType : IType → Prop where
  | empty : FlatType .empty
  | atom (a : AType) : FlatType (.atomic a)
  | optional (a : AType) : FlatType (.seq (.atomic a) .opt)
  | top : FlatType top
  | pair (a b : AType) : FlatType (.seq (.choice [.atomic a, .atomic b]) .plus)
  | optionalPair (a b : AType) : FlatType (.seq (.choice [.atomic a, .atomic b]) .star)

theorem seqMatches_top (env : Env) (s : Seq) : env.seqMatches s top = true := by
  simp [Env.seqMatches, Env.seqMatchesF, Env.itemMatchesF, top, occOk]

theorem seqMatches_empty (env : Env) : env.seqMatches [] .empty = true := rfl

theorem flat_join_empty {t : IType} (h : FlatType t) : FlatType (join t .empty) := by
  cases h <;> simp [join, withOcc, itemType, allowsMany, top] <;> constructor

theorem flat_empty_join {t : IType} (h : FlatType t) : FlatType (join .empty t) := by
  cases h <;> simp [join, withOcc, itemType, allowsMany, top] <;> constructor

theorem matches_join_empty {t : IType} (ht : FlatType t) (env : Env) (s : Seq)
    (hs : env.seqMatches s t = true) : env.seqMatches s (join t .empty) = true := by
  cases ht with
  | empty => exact hs
  | atom a =>
    simp only [Env.seqMatches, Env.seqMatchesF, List.all_eq_true,
      Bool.and_eq_true, beq_iff_eq] at hs
    simpa [join, withOcc, itemType, allowsMany, Env.seqMatches,
      Env.seqMatchesF, occOk, hs.1, List.all_eq_true] using hs.2
  | optional a => exact hs
  | top => exact seqMatches_top env s
  | pair a b =>
    simp only [Env.seqMatches, Env.seqMatchesF, Bool.and_eq_true] at hs
    simpa [join, withOcc, itemType, allowsMany, Env.seqMatches,
      Env.seqMatchesF, occOk] using hs.2
  | optionalPair a b => exact hs

theorem matches_empty_join {t : IType} (ht : FlatType t) (env : Env) (s : Seq)
    (hs : env.seqMatches s t = true) : env.seqMatches s (join .empty t) = true := by
  cases ht with
  | empty => exact hs
  | atom a => exact matches_join_empty (.atom a) env s hs
  | optional a => exact hs
  | top => exact seqMatches_top env s
  | pair a b => exact matches_join_empty (.pair a b) env s hs
  | optionalPair a b => exact hs

theorem empty_matches_join {t : IType} (ht : FlatType t) (env : Env) :
    env.seqMatches [] (join t .empty) = true ∧
    env.seqMatches [] (join .empty t) = true := by
  cases ht <;> simp [join, withOcc, itemType, allowsMany, top,
    Env.seqMatches, Env.seqMatchesF, occOk]

theorem atomic_derives_self (a : AType) : a.derives a = true := by
  cases a <;> simp [AType.derives, XSD.derivedFrom, XSD.derivedFromFuel]

theorem literal_matches (env : Env) (a : Atomic) :
    env.seqMatches [.atom a] (.atomic a.ty) = true := by
  simp [Env.seqMatches, Env.seqMatchesF, Env.itemMatchesF, atomic_derives_self]

theorem pair_matches (env : Env) (a b : Atomic) :
    env.seqMatches [.atom a, .atom b]
      (.seq (.choice [.atomic a.ty, .atomic b.ty]) .plus) = true := by
  change (true &&
    ((a.ty.derives a.ty || (a.ty.derives b.ty || false)) &&
      ((b.ty.derives a.ty || (b.ty.derives b.ty || false)) && true))) = true
  simp only [atomic_derives_self, Bool.true_or, Bool.or_true, Bool.true_and]

theorem push_loop (s : Seq) (out : Array Item) :
    (do
      let out ← forIn s out fun i acc => pure (ForInStep.yield (acc.push i))
      pure out.toList : M Seq) = .ok (out.toList ++ s) := by
  induction s generalizing out with
  | nil => simp; rfl
  | cons i s ih =>
    simpa [List.forIn_cons, Array.toList_push, List.append_assoc] using ih (out.push i)

theorem eval_singleton (n : Nat) (env : Env) (e : Expr) :
    eval (n + 1) env (.seq [e]) = eval n env e := by
  change (do
    let mut out : Array Item := #[]
    for x in [e] do
      for i in ← eval n env x do out := out.push i
    pure out.toList) = eval n env e
  simp only [List.forIn_cons, List.forIn_nil]
  cases h : eval n env e with
  | error er => rfl
  | ok s =>
    simp

theorem infer_singleton (n : Nat) (env : Env) (ctx : Ctx) (e : Expr) :
    infer (n + 1) env ctx (.seq [e]) = infer n env ctx e := by
  change (do
    let ts ← [e].mapM (infer n env ctx)
    pure (ts.foldl concat .empty)) = infer n env ctx e
  cases h : infer n env ctx e with
  | error er => simp [List.mapM_cons, h]; rfl
  | ok t => simp [List.mapM_cons, h, concat]

/-- Sufficient analyser fuel is a syntactic condition. No value-matching
    premise is assumed; the result uses Core's public sequence matcher. -/
theorem fragment_infer_sound {e : Expr} (fragment : Fragment e) :
    ∀ (typingFuel : Nat) (env : Env) (ctx : Ctx) (t : IType),
      sizeOf e < typingFuel → infer typingFuel env ctx e = .ok t →
      FlatType t ∧ ∀ (evalFuel : Nat) (s : Seq),
        eval evalFuel env e = .ok s → env.seqMatches s t = true := by
  induction fragment with
  | literal a =>
    intro typingFuel env ctx t budget hi
    cases typingFuel with
    | zero => omega
    | succ n =>
      have ht : IType.atomic a.ty = t := Except.ok.inj hi
      subst t
      refine ⟨.atom a.ty, ?_⟩
      intro evalFuel s he
      cases evalFuel with
      | zero => contradiction
      | succ m =>
        have hs : [.atom a] = s := Except.ok.inj he
        subst s
        exact literal_matches env a
  | empty =>
    intro typingFuel env ctx t budget hi
    cases typingFuel with
    | zero => omega
    | succ n =>
      have ht : IType.empty = t := Except.ok.inj hi
      subst t
      refine ⟨.empty, ?_⟩
      intro evalFuel s he
      cases evalFuel with
      | zero => contradiction
      | succ m =>
        have hs : [] = s := Except.ok.inj he
        subst s
        exact seqMatches_empty env
  | pair a b =>
    intro typingFuel env ctx t budget hi
    cases typingFuel with
    | zero => omega
    | succ n =>
      cases n with
      | zero => simp at budget
      | succ n =>
        have ht : IType.seq (.choice [.atomic a.ty, .atomic b.ty]) .plus = t := Except.ok.inj hi
        subst t
        refine ⟨.pair a.ty b.ty, ?_⟩
        intro evalFuel s he
        cases evalFuel with
        | zero => contradiction
        | succ m =>
          cases m with
          | zero => contradiction
          | succ m =>
            have hs : [.atom a, .atom b] = s := Except.ok.inj he
            subst s
            exact pair_matches env a b
  | singleton admitted ih =>
    intro typingFuel env ctx t budget hi
    cases typingFuel with
    | zero => omega
    | succ n =>
      rw [infer_singleton] at hi
      obtain ⟨ht, sound⟩ := ih n env ctx t (by simp at budget; omega) hi
      refine ⟨ht, ?_⟩
      intro evalFuel s he
      cases evalFuel with
      | zero => contradiction
      | succ m => exact sound m s (by rwa [eval_singleton] at he)
  | @thenEmpty c e admitted ih =>
    intro typingFuel env ctx t budget hi
    cases typingFuel with
    | zero => omega
    | succ n =>
      cases n with
      | zero => simp at budget
      | succ n =>
        change (do
          checkEBV (← infer (n + 1) env ctx c)
          let ta ← infer (n + 1) env ctx e
          pure (join ta .empty)) = .ok t at hi
        cases hc : infer (n + 1) env ctx c with
        | error er => simp [hc, bind, Except.bind] at hi
        | ok tc =>
          cases hb : checkEBV tc with
          | error er => simp [hc, hb, bind, Except.bind] at hi
          | ok u =>
            cases ha : infer (n + 1) env ctx e with
            | error er => simp [hc, hb, ha, bind, Except.bind] at hi
            | ok ta =>
              have ht : join ta .empty = t := by
                simpa [hc, hb, ha, bind, Except.bind, pure, Except.pure] using hi
              subst t
              obtain ⟨flat, sound⟩ := ih (n + 1) env ctx ta (by simp at budget; omega) ha
              refine ⟨flat_join_empty flat, ?_⟩
              intro evalFuel s he
              cases evalFuel with
              | zero => contradiction
              | succ m =>
                change (do
                  if ← ebv (← eval m env c) then eval m env e
                  else eval m env (.seq [])) = .ok s at he
                cases hce : eval m env c with
                | error er => simp [hce, bind, Except.bind] at he
                | ok cs =>
                  cases hbe : ebv cs with
                  | error er => simp [hce, hbe, bind, Except.bind] at he
                  | ok b =>
                    cases b with
                    | true =>
                      have hes : eval m env e = .ok s := by
                        simpa [hce, hbe, bind, Except.bind] using he
                      exact matches_join_empty flat env s (sound m s hes)
                    | false =>
                      have hes : eval m env (.seq []) = .ok s := by
                        simpa [hce, hbe, bind, Except.bind] using he
                      cases m with
                      | zero => contradiction
                      | succ m =>
                        have hs : [] = s := Except.ok.inj hes
                        subst s
                        exact (empty_matches_join flat env).1
  | @elseEmpty c e admitted ih =>
    intro typingFuel env ctx t budget hi
    cases typingFuel with
    | zero => omega
    | succ n =>
      cases n with
      | zero => simp at budget
      | succ n =>
        change (do
          checkEBV (← infer (n + 1) env ctx c)
          let ta ← infer (n + 1) env ctx e
          pure (join .empty ta)) = .ok t at hi
        cases hc : infer (n + 1) env ctx c with
        | error er => simp [hc, bind, Except.bind] at hi
        | ok tc =>
          cases hb : checkEBV tc with
          | error er => simp [hc, hb, bind, Except.bind] at hi
          | ok u =>
            cases ha : infer (n + 1) env ctx e with
            | error er => simp [hc, hb, ha, bind, Except.bind] at hi
            | ok ta =>
              have ht : join .empty ta = t := by
                simpa [hc, hb, ha, bind, Except.bind, pure, Except.pure] using hi
              subst t
              obtain ⟨flat, sound⟩ := ih (n + 1) env ctx ta (by simp at budget; omega) ha
              refine ⟨flat_empty_join flat, ?_⟩
              intro evalFuel s he
              cases evalFuel with
              | zero => contradiction
              | succ m =>
                change (do
                  if ← ebv (← eval m env c) then eval m env (.seq [])
                  else eval m env e) = .ok s at he
                cases hce : eval m env c with
                | error er => simp [hce, bind, Except.bind] at he
                | ok cs =>
                  cases hbe : ebv cs with
                  | error er => simp [hce, hbe, bind, Except.bind] at he
                  | ok b =>
                    cases b with
                    | false =>
                      have hes : eval m env e = .ok s := by
                        simpa [hce, hbe, bind, Except.bind] using he
                      exact matches_empty_join flat env s (sound m s hes)
                    | true =>
                      have hes : eval m env (.seq []) = .ok s := by
                        simpa [hce, hbe, bind, Except.bind] using he
                      cases m with
                      | zero => contradiction
                      | succ m =>
                        have hs : [] = s := Except.ok.inj hes
                        subst s
                        exact (empty_matches_join flat env).2

/-- Actual inference success and actual evaluation success imply membership
    in the inferred public sequence type, on the admitted fragment. -/
theorem fragment_sound {e : Expr} (fragment : Fragment e)
    (typingFuel evalFuel : Nat) (env : Env) (ctx : Ctx) (t : IType) (s : Seq)
    (budget : sizeOf e < typingFuel)
    (inferred : infer typingFuel env ctx e = .ok t)
    (evaluated : eval evalFuel env e = .ok s) : env.seqMatches s t = true :=
  (fragment_infer_sound fragment typingFuel env ctx t budget inferred).2 evalFuel s evaluated

#print axioms fragment_infer_sound
#print axioms fragment_sound

end L4Factoidal.XPath4.StaticTyping
