-- P3: the two additions of `mac`
theorem p3 (hi lo c d x : Nat) (hhi : hi < 18446744073709551616) (hlo : lo < 18446744073709551616)
    (hc : c < 18446744073709551616) (hd : d < 18446744073709551616)
    (hx : hi * 18446744073709551616 + lo = x)
    (hb : x + c + d < 340282366920938463463374607431768211456)
    (h1 : (lo + c) % 18446744073709551616 < lo)
    (h2 : ¬ ((lo + c) % 18446744073709551616 + d) % 18446744073709551616 < (lo + c) % 18446744073709551616) :
    ((hi + 1) % 18446744073709551616 + 0) % 18446744073709551616 * 18446744073709551616 +
      ((lo + c) % 18446744073709551616 + d) % 18446744073709551616 = x + c + d := by omega
theorem p3a (hi lo c d : Nat) (hhi : hi < 18446744073709551616) (hlo : lo < 18446744073709551616)
    (hc : c < 18446744073709551616) (hd : d < 18446744073709551616)
    (hb : hi * 18446744073709551616 + lo + c + d < 340282366920938463463374607431768211456)
    (h1 : (lo + c) % 18446744073709551616 < lo)
    (h2 : ¬ ((lo + c) % 18446744073709551616 + d) % 18446744073709551616 < (lo + c) % 18446744073709551616) :
    ((hi + 1) % 18446744073709551616 + 0) % 18446744073709551616 * 18446744073709551616 +
      ((lo + c) % 18446744073709551616 + d) % 18446744073709551616 =
        hi * 18446744073709551616 + lo + c + d := by omega
theorem p3b (hi lo c d : Nat) (hhi : hi ≤ 18446744073709551614) (hlo : lo < 18446744073709551616)
    (hc : c < 18446744073709551616) (hd : d < 18446744073709551616)
    (hb : hi = 18446744073709551614 → lo ≤ 1)
    (h1 : (lo + c) % 18446744073709551616 < lo)
    (h2 : ¬ ((lo + c) % 18446744073709551616 + d) % 18446744073709551616 < (lo + c) % 18446744073709551616) :
    ((hi + 1) % 18446744073709551616 + 0) % 18446744073709551616 * 18446744073709551616 +
      ((lo + c) % 18446744073709551616 + d) % 18446744073709551616 =
        hi * 18446744073709551616 + lo + c + d := by omega
theorem p3c (hi lo x : Nat) (hlo : lo < 18446744073709551616)
    (hx : hi * 18446744073709551616 + lo = x)
    (hb : x ≤ 340282366920938463426481119284349108225) :
    hi ≤ 18446744073709551614 ∧ (hi = 18446744073709551614 → lo ≤ 1) := by omega
-- small analogue of p3
theorem p3d (hi lo c d x : Nat) (hhi : hi < 16) (hlo : lo < 16) (hc : c < 16) (hd : d < 16)
    (hx : hi * 16 + lo = x) (hb : x + c + d < 256)
    (h1 : (lo + c) % 16 < lo) (h2 : ¬ ((lo + c) % 16 + d) % 16 < (lo + c) % 16) :
    ((hi + 1) % 16 + 0) % 16 * 16 + ((lo + c) % 16 + d) % 16 = x + c + d := by omega

-- P4: a chain of equalities with 2^64 weights (as in addCarry)
theorem p4 (a0 a1 b0 b1 s0 s1 c0 c1 : Nat)
    (h0 : c0 * 2^64 + s0 = a0 + b0 + 0) (h1 : c1 * 2^64 + s1 = a1 + b1 + c0) :
    c1 * 2^128 + (s0 + s1 * 2^64) = (a0 + a1 * 2^64) + (b0 + b1 * 2^64) := by omega
theorem p4a (a0 a1 b0 b1 s0 s1 c0 c1 : Nat)
    (h0 : c0 * 18446744073709551616 + s0 = a0 + b0 + 0) (h1 : c1 * 18446744073709551616 + s1 = a1 + b1 + c0) :
    c1 * 340282366920938463463374607431768211456 + (s0 + s1 * 18446744073709551616) =
      (a0 + a1 * 18446744073709551616) + (b0 + b1 * 18446744073709551616) := by omega

