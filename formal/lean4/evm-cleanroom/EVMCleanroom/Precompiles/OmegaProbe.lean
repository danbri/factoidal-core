namespace OmegaProbe

-- P1: a hypothesis that is a division identity
set_option diagnostics true in
theorem p1 (a b : Nat) (ha : a < 2^64) (hb : b < 2^64)
    (hA : a / 4294967296 * 4294967296 + a % 4294967296 = a) :
    b / 4294967296 * 4294967296 + b % 4294967296 = b := by omega
theorem p1a (a b : Nat)
    (hA : a / 4294967296 * 4294967296 + a % 4294967296 = a) :
    b / 4294967296 * 4294967296 + b % 4294967296 = b := by omega
theorem p1b (a b : Nat) (hA : a / 4 * 4 + a % 4 = a) : b / 4 * 4 + b % 4 = b := by omega
theorem p1c (a b : Nat) (hA : a / 4 * 4 + a % 4 = a) (h : b < 5) : b < 6 := by omega
theorem p1d (b : Nat) : b / 4294967296 * 4294967296 + b % 4294967296 = b := by omega
theorem p1e (a b : Nat) (ha : a < 2^64) (hb : b < 2^64) (hc : a < 2^64) (hd : b < 2^64) (he : a + b < 2^65) :
    b / 4294967296 * 4294967296 + b % 4294967296 = b := by omega

